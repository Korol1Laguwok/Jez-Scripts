-- ============================================================================
-- DRAGGABLE ДЛЯ FRAME
-- ============================================================================
local dragging, dragInput, dragStart, startPos

local function updateDrag(input)
    local delta = input.Position - dragStart
    mainFrame.Position = UDim2.new(
        startPos.X.Scale, startPos.X.Offset + delta.X,
        startPos.Y.Scale, startPos.Y.Offset + delta.Y
    )
end

mainFrame.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        startPos = mainFrame.Position

        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                dragging = false
            end
        end)
    end
end)

mainFrame.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
        dragInput = input
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if input == dragInput and dragging then
        updateDrag(input)
    end
end)

-- ============================================================================
-- ЛОГИКА СКРЫТИЯ И ВОССТАНОВЛЕНИЯ
-- ============================================================================

toggleBtn.MouseButton1Click:Connect(function()
    isEnabled = not isEnabled
    toggleBtn.Text = isEnabled and "Режим: ВКЛ" or "Режим: ВЫКЛ"
    toggleBtn.BackgroundColor3 = isEnabled and Color3.fromRGB(50, 180, 50) or Color3.fromRGB(180, 50, 50)
end)

local function isSafeToHide(target)
    if not target or target == Workspace or target == workspace.Terrain then return false end
    if player.Character and target:IsDescendantOf(player.Character) then return false end
    if target:IsA("Terrain") or target:IsA("Camera") then return false end
    return true
end

local function hideObject(target)
    if not isSafeToHide(target) then return end

    -- Удаляем строго тот Part, по которому кликнули
    local objToHide = target

    if deletedObjects[objToHide] or not isSafeToHide(objToHide) then return end

    local originalParent = objToHide.Parent
    deletedObjects[objToHide] = originalParent
    objToHide.Parent = nil

    local itemBtn = Instance.new("TextButton")
    itemBtn.Size = UDim2.new(1, -6, 0, 25)
    itemBtn.BackgroundColor3 = Color3.fromRGB(45, 45, 55)
    itemBtn.Text = " [Вернуть] " .. string.sub(objToHide.Name, 1, 20)
    itemBtn.TextColor3 = Color3.fromRGB(220, 220, 220)
    itemBtn.TextSize = 11
    itemBtn.Font = Enum.Font.SourceSans
    itemBtn.Parent = scrollList

    itemBtn.MouseButton1Click:Connect(function()
        if objToHide and deletedObjects[objToHide] then
            objToHide.Parent = deletedObjects[objToHide]
            deletedObjects[objToHide] = nil
        end
        itemBtn:Destroy()
    end)
end

restoreAllBtn.MouseButton1Click:Connect(function()
    for obj, originalParent in pairs(deletedObjects) do
        if obj and originalParent then
            obj.Parent = originalParent
        end
    end
    table.clear(deletedObjects)

    for _, child in ipairs(scrollList:GetChildren()) do
        if child:IsA("TextButton") then
            child:Destroy()
        end
    end
end)

local function getTargetUnderMouse()
    local mousePosition = UserInputService:GetMouseLocation()
    local unitRay = camera:ViewportPointToRay(mousePosition.X, mousePosition.Y)

    local raycastParams = RaycastParams.new()
    raycastParams.FilterType = Enum.RaycastFilterType.Exclude

    if player.Character then
        raycastParams.FilterDescendantsInstances = { player.Character }
    end

    local result = Workspace:Raycast(unitRay.Origin, unitRay.Direction * 1000, raycastParams)
    return result and result.Instance or nil
end

-- ============================================================================
-- ОБРАБОТКА ОДИНОЧНОГО НАЖАТИЯ
-- ============================================================================

UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end

    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        if isEnabled and not isClickProcessed and UserInputService:IsKeyDown(Enum.KeyCode.R) then
            isClickProcessed = true
            
            local target = getTargetUnderMouse()
            if target then
                hideObject(target)
            end
        end
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        isClickProcessed = false
    end
end)
