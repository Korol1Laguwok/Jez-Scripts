local openDropdown = nil
local function toggleDropdown(targetDrop, targetHeight)
    if openDropdown and openDropdown ~= targetDrop then
        TweenService:Create(openDropdown, TweenInfo.new(0.15), {Size = UDim2.new(0, 260, 0, 0)}):Play()
    end

    if targetDrop.Size.Y.Offset > 0 then
        TweenService:Create(targetDrop, TweenInfo.new(0.15), {Size = UDim2.new(0, 260, 0, 0)}):Play()
        openDropdown = nil
    else
        TweenService:Create(targetDrop, TweenInfo.new(0.15), {Size = UDim2.new(0, 260, 0, targetHeight)}):Play()
        openDropdown = targetDrop
    end
end

