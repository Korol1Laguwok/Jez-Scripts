-- Логика скрытия/открытия окна с анимацией
local isMenuVisible = true
local isAnimating = false

local function toggleMenuVisibility()
    if isAnimating then return end
    isAnimating = true

    if isMenuVisible then
        local hideTween = TweenService:Create(frame, TweenInfo.new(0.25, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
            Size = UDim2.new(0, 0, 0, 0),
            Position = UDim2.new(frame.Position.X.Scale, frame.Position.X.Offset + 145, frame.Position.Y.Scale, frame.Position.Y.Offset + 210),
            BackgroundTransparency = 1
        })
        hideTween:Play()
        hideTween.Completed:Wait()
        frame.Visible = false
        isMenuVisible = false
    else
        frame.Visible = true
        local showTween = TweenService:Create(frame, TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
            Size = defaultFrameSize,
            Position = defaultFramePos,
            BackgroundTransparency = 0
        })
        showTween:Play()
        showTween.Completed:Wait()
        isMenuVisible = true
    end

    isAnimating = false
end

