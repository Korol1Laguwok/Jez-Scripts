-- Проверка видимости
local function isPartVisible(targetPart)
    if not wallCheckEnabled then 
        return true 
    end

    local origin = camera.CFrame.Position
    local destination = targetPart.Position
    local direction = destination - origin

    local raycastParams = RaycastParams.new()
    raycastParams.FilterType = Enum.RaycastFilterType.Exclude

    local filterList = {camera}
    if localPlayer.Character then
        table.insert(filterList, localPlayer.Character)
    end
    raycastParams.FilterDescendantsInstances = filterList

    local result = workspace:Raycast(origin, direction, raycastParams)
    
    if not result then
        return true
    end

    if result.Instance:IsDescendantOf(targetPart.Parent) then
        return true
    end

    return false
end

-- Обработка клавиш
local function checkInputMatch(input)
    if selectedKeybind.EnumType == Enum.UserInputType then
        return input.UserInputType == selectedKeybind
    elseif selectedKeybind.EnumType == Enum.KeyCode then
        return input.KeyCode == selectedKeybind
    end
    return false
end

UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if input.KeyCode == Enum.KeyCode.RightAlt then
        toggleMenuVisibility()
        return
    end

    if gameProcessed then return end
    if checkInputMatch(input) then
        isAiming = true
    end
end)

-- При отжатии клавиши сбрасывается выбранная цель
UserInputService.InputEnded:Connect(function(input)
    if checkInputMatch(input) then
        isAiming = false
        lockedPlayer = nil
        highlight.Enabled = false
    end
end)

-- Проверка команд
local function isTeamTargetable(player)
    if player.Team then
        local state = teamTargetState[player.Team.Name]
        if state ~= nil then
            return state
        end
    end
    return player.Team ~= localPlayer.Team
end

-- Поиск первой ближайшей цели
local function getClosestPlayer()
    local closestPlayer = nil
    local shortestDistance = math.huge
    local mousePos = UserInputService:GetMouseLocation()

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= localPlayer and player.Character and player.Character:FindFirstChild("Humanoid") and player.Character.Humanoid.Health > 0 then
            
            if not isTeamTargetable(player) then
                continue
            end

            local targetPart = player.Character:FindFirstChild(selectedPartId) or player.Character:FindFirstChild("HumanoidRootPart")

            if targetPart then
                local screenPos, onScreen = camera:WorldToViewportPoint(targetPart.Position)
                if onScreen then
                    if wallCheckEnabled and not isPartVisible(targetPart) then
                        continue
                    end

                    local distance = (Vector2.new(screenPos.X, screenPos.Y) - mousePos).Magnitude
                    if distance < shortestDistance then
                        shortestDistance = distance
                        closestPlayer = player
                    end
                end
            end
        end
    end
    return closestPlayer
end

-- Проверка жива ли выбранная цель
local function isTargetValid(player)
    if player and player.Parent and player.Character and player.Character:FindFirstChild("Humanoid") then
        return player.Character.Humanoid.Health > 0
    end
    return false
end

-- Главный цикл
RunService.RenderStepped:Connect(function()
    if isAimbotEnabled and isAiming then
        -- Если цели еще нет или текущая цель умерла/вышла — ищем новую
        if not isTargetValid(lockedPlayer) then
            lockedPlayer = getClosestPlayer()
        end

        if isTargetValid(lockedPlayer) then
            local targetPart = lockedPlayer.Character:FindFirstChild(selectedPartId) or lockedPlayer.Character:FindFirstChild("HumanoidRootPart")

            if targetPart then
                -- Если цель перекрыта стеной, наводка приостанавливается, но цель НЕ меняется
                if wallCheckEnabled and not isPartVisible(targetPart) then
                    highlight.Enabled = false
                    return
                end

                highlight.Adornee = lockedPlayer.Character
                highlight.Enabled = true

                local targetCFrame = CFrame.new(camera.CFrame.Position, targetPart.Position)
                camera.CFrame = camera.CFrame:Lerp(targetCFrame, selectedSmoothVal)
            else
                highlight.Enabled = false
            end
        else
            lockedPlayer = nil
            highlight.Enabled = false
        end
    else
        highlight.Enabled = false
    end
end)
