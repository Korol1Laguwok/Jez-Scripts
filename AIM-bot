-- Обновление списка команд в GUI
local function refreshTeamList()
    for _, child in ipairs(teamScroll:GetChildren()) do
        if child:IsA("TextButton") then
            child:Destroy()
        end
    end

    local foundTeams = Teams:GetTeams()
    
    if #foundTeams == 0 then
        local noTeamsLabel = Instance.new("TextLabel")
        noTeamsLabel.Size = UDim2.new(1, 0, 0, 30)
        noTeamsLabel.BackgroundTransparency = 1
        noTeamsLabel.Text = "Команды не найдены"
        noTeamsLabel.TextColor3 = Color3.fromRGB(150, 150, 160)
        noTeamsLabel.TextSize = 11
        noTeamsLabel.Font = Enum.Font.Gotham
        noTeamsLabel.ZIndex = 5
        noTeamsLabel.Parent = teamScroll
        return
    end

    for _, team in ipairs(foundTeams) do
        if teamTargetState[team.Name] == nil then
            teamTargetState[team.Name] = (team ~= localPlayer.Team)
        end

        local isTargeting = teamTargetState[team.Name]

        local teamRow = Instance.new("TextButton")
        teamRow.Size = UDim2.new(1, 0, 0, 26)
        teamRow.BackgroundColor3 = Color3.fromRGB(34, 34, 42)
        teamRow.BackgroundTransparency = 0.5
        teamRow.BorderSizePixel = 0
        teamRow.Text = (isTargeting and " [ ✔ ]  " or " [ ✖ ]  ") .. team.Name
        teamRow.TextColor3 = isTargeting and Color3.fromRGB(80, 220, 120) or Color3.fromRGB(240, 80, 80)
        teamRow.TextSize = 11
        teamRow.TextXAlignment = Enum.TextXAlignment.Left
        teamRow.Font = Enum.Font.GothamMedium
        teamRow.ZIndex = 5
        teamRow.Parent = teamScroll

        teamRow.MouseButton1Click:Connect(function()
            teamTargetState[team.Name] = not teamTargetState[team.Name]
            local updatedState = teamTargetState[team.Name]
            teamRow.Text = (updatedState and " [ ✔ ]  " or " [ ✖ ]  ") .. team.Name
            teamRow.TextColor3 = updatedState and Color3.fromRGB(80, 220, 120) or Color3.fromRGB(240, 80, 80)
        end)
    end
end

