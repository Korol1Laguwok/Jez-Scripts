local flyEnabled = false
local flySpeed = 1
local upHolding = false
local downHolding = false
local flyConnection = nil

task.spawn(function()
    while true do
        task.wait(0.03)
        if flyEnabled then
            local char = LocalPlayer.Character
            local hrp = char and char:FindFirstChild("HumanoidRootPart")
            if hrp then
                if upHolding then
                    hrp.CFrame = hrp.CFrame * CFrame.new(0, 1, 0)
                elseif downHolding then
                    hrp.CFrame = hrp.CFrame * CFrame.new(0, -1, 0)
                end
            end
        end
    end
end)

local function stopFly()
    flyEnabled = false
    upHolding = false
    downHolding = false

    if flyConnection then
        flyConnection:Disconnect()
        flyConnection = nil
    end

    local char = LocalPlayer.Character
    if char then
        local hum = char:FindFirstChildWhichIsA("Humanoid")
        local hrp = char:FindFirstChild("HumanoidRootPart")

        if hum then
            hum.PlatformStand = false
            for _, state in ipairs(Enum.HumanoidStateType:GetEnumItems()) do
                pcall(function() hum:SetStateEnabled(state, true) end)
            end
            hum:ChangeState(Enum.HumanoidStateType.RunningNoPhysics)
        end

        if char:FindFirstChild("Animate") then
            char.Animate.Disabled = false
        end

        local targetPart = char:FindFirstChild("Torso") or char:FindFirstChild("UpperTorso") or hrp
        if targetPart then
            for _, v in ipairs(targetPart:GetChildren()) do
                if v.Name == "FlyGyro" or v.Name == "FlyVel" then
                    v:Destroy()
                end
            end
        end
    end
end

local function startFly()
    stopFly()

    local char = LocalPlayer.Character
    if not char then return end
    local hum = char:FindFirstChildWhichIsA("Humanoid")
    local targetPart = char:FindFirstChild("Torso") or char:FindFirstChild("UpperTorso") or char:FindFirstChild("HumanoidRootPart")
    if not hum or not targetPart then return end

    flyEnabled = true

    if char:FindFirstChild("Animate") then
        char.Animate.Disabled = true
    end
    pcall(function()
        for _, v in next, hum:GetPlayingAnimationTracks() do
            v:AdjustSpeed(0)
        end
    end)

    for _, state in ipairs(Enum.HumanoidStateType:GetEnumItems()) do
        pcall(function() hum:SetStateEnabled(state, false) end)
    end
    hum:ChangeState(Enum.HumanoidStateType.Swimming)
    hum.PlatformStand = true

    flyConnection = game:GetService("RunService").Heartbeat:Connect(function()
        if flyEnabled and char and hum and hum.Parent then
            if hum.MoveDirection.Magnitude > 0 then
                for i = 1, flySpeed do
                    char:TranslateBy(hum.MoveDirection)
                end
            end
        else
            stopFly()
        end
    end)

    local bg = Instance.new("BodyGyro", targetPart)
    bg.Name = "FlyGyro"
    bg.P = 9e4
    bg.MaxTorque = Vector3.new(9e9, 9e9, 9e9)
    bg.CFrame = targetPart.CFrame

    local bv = Instance.new("BodyVelocity", targetPart)
    bv.Name = "FlyVel"
    bv.Velocity = Vector3.new(0, 0.1, 0)
    bv.MaxForce = Vector3.new(9e9, 9e9, 9e9)

    task.spawn(function()
        local camera = workspace.CurrentCamera
        while flyEnabled and char and hum and hum.Parent do
            game:GetService("RunService").RenderStepped:Wait()
            bg.CFrame = camera.CFrame
        end
    end)
end

