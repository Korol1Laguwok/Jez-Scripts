    local bv, bg = nil, nil

    local function applyVFlySpeed(val)
        vFlySpeed = math.clamp(math.floor(val or 50), 1, 1000)
        vFlySpeedInput.Text = tostring(vFlySpeed)
    end

    local function getVehicleRoot()
        local char = LocalPlayer.Character
        if not char then return nil end
        local hum = char:FindFirstChildWhichIsA("Humanoid")
        if not hum or not hum.SeatPart then return nil end
        return hum.SeatPart.AssemblyRootPart or hum.SeatPart
    end

    local function toggleVFly()
        vFlyActive = not vFlyActive
        
        if vFlyActive then
            vFlyToggleBtn.Text = "V-FLY" .. L("StatusOn")
            vFlyToggleBtn.TextColor3 = Color3.fromRGB(60, 225, 100)

            vFlyConnection = RunService.RenderStepped:Connect(function()
                local root = getVehicleRoot()
                if root then
                    if not bv or bv.Parent ~= root then
                        if bv then bv:Destroy() end
                        bv = Instance.new("BodyVelocity")
                        bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
                        bv.Parent = root
                    end
                    if not bg or bg.Parent ~= root then
                        if bg then bg:Destroy() end
                        bg = Instance.new("BodyGyro")
                        bg.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
                        bg.P = 10000
                        bg.Parent = root
                    end

                    local cam = workspace.CurrentCamera
                    bg.CFrame = cam.CFrame

                    local moveDir = Vector3.zero
                    if UIS:IsKeyDown(Enum.KeyCode.W) then moveDir = moveDir + cam.CFrame.LookVector end
                    if UIS:IsKeyDown(Enum.KeyCode.S) then moveDir = moveDir - cam.CFrame.LookVector end
                    if UIS:IsKeyDown(Enum.KeyCode.A) then moveDir = moveDir - cam.CFrame.RightVector end
                    if UIS:IsKeyDown(Enum.KeyCode.D) then moveDir = moveDir + cam.CFrame.RightVector end

                    if moveDir.Magnitude > 0 then
                        bv.Velocity = moveDir.Unit * vFlySpeed
                    else
                        bv.Velocity = Vector3.zero
                    end
                else
                    if bv then bv:Destroy() bv = nil end
                    if bg then bg:Destroy() bg = nil end
                end
            end)
        else
            vFlyToggleBtn.Text = "V-FLY" .. L("StatusOff")
            vFlyToggleBtn.TextColor3 = Color3.fromRGB(225, 60, 60)

            if vFlyConnection then
                vFlyConnection:Disconnect()
                vFlyConnection = nil
            end
            if bv then bv:Destroy() bv = nil end
            if bg then bg:Destroy() bg = nil end
        end
    end

    vFlyToggleBtn.MouseButton1Click:Connect(toggleVFly)

    vFlyPlusBtn.MouseButton1Click:Connect(function()
        applyVFlySpeed(vFlySpeed + 10)
    end)

    vFlyMinusBtn.MouseButton1Click:Connect(function()
        applyVFlySpeed(vFlySpeed - 10)
    end)

    vFlySpeedInput.FocusLost:Connect(function()
