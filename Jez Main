local clockWidgetRef = nil
local clockStrokeRef = nil
local clockTimeRef = nil
local clockDateRef = nil

local function stopRainbowTheme()
    isRainbowActive = false
    if rainbowConnection then
        rainbowConnection:Disconnect()
        rainbowConnection = nil
    end
end

local function startRainbowTheme()
    stopRainbowTheme()
    isRainbowActive = true
    
    rainbowConnection = RunService.RenderStepped:Connect(function()
        if not isRainbowActive then return end
        
        local hue = (tick() * 0.25) % 1
        local accentColor = Color3.fromHSV(hue, 0.8, 1)
        local darkAccent   = Color3.fromHSV(hue, 0.7, 0.25)
        local blackBG      = Color3.fromHSV(hue, 0.6, 0.1)
        
        MainFrame.BackgroundColor3 = blackBG
        Header.BackgroundColor3 = darkAccent
        MainStroke.Color = accentColor
        HeaderDivider.BackgroundColor3 = accentColor
        HeaderLogo.TextColor3 = accentColor
        HeaderTitle.TextColor3 = Color3.fromRGB(240, 240, 240)
        
        FloatingBtn.BackgroundColor3 = darkAccent
        FloatingBtn.TextColor3 = accentColor
        FloatStroke.Color = accentColor
        ScrollLeftBtn.BackgroundColor3 = darkAccent
        ScrollLeftStroke.Color = accentColor
        ScrollRightBtn.BackgroundColor3 = darkAccent
        ScrollRightStroke.Color = accentColor
        
        if clockWidgetRef then
            clockWidgetRef.BackgroundColor3 = darkAccent
            clockStrokeRef.Color = accentColor
            clockTimeRef.TextColor3 = accentColor
        end
        
        for _, tabData in ipairs(tabs) do
            tabData.Stroke.Color = accentColor
            tabData.Stroke.Transparency = (activeTab == tabData) and 0 or 0.6
            tabData.Page.ScrollBarImageColor3 = accentColor
            if activeTab == tabData then
                tabData.Button.BackgroundColor3 = accentColor
                tabData.Button.TextColor3 = Color3.fromRGB(15, 15, 15)
            else
                tabData.Button.BackgroundColor3 = darkAccent
                tabData.Button.TextColor3 = Color3.fromRGB(200, 200, 200)
            end
        end
        
        for _, item in ipairs(registeredButtons) do
            if item.Button and item.Button.Parent then
                item.Button.BackgroundColor3 = darkAccent
                if item.Button:IsA("TextButton") and item.Button ~= LangBtn then
                    item.Button.TextColor3 = Color3.fromRGB(245, 245, 245)
                end
            end
            if item.Stroke and item.Stroke.Parent then
                item.Stroke.Color = accentColor
                item.Stroke.Transparency = 0
                item.Stroke.Enabled = true
            end
        end
    end)
end

local function applyTheme(theme)
    stopRainbowTheme()
    CurrentTheme = theme
    local tInfo = TweenInfo.new(0.35, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
    
    tween(MainFrame, tInfo, {BackgroundColor3 = theme.Black})
    tween(Header, tInfo, {BackgroundColor3 = theme.Dark})
    tween(MainStroke, tInfo, {Color = theme.Grey})
    tween(HeaderDivider, tInfo, {BackgroundColor3 = theme.Grey})
    tween(HeaderLogo, tInfo, {TextColor3 = theme.White})
    tween(HeaderTitle, tInfo, {TextColor3 = theme.Light})
    
    tween(FloatingBtn, tInfo, {BackgroundColor3 = theme.Dark, TextColor3 = theme.White})
    tween(FloatStroke, tInfo, {Color = theme.Grey})
    tween(ScrollLeftBtn, tInfo, {BackgroundColor3 = theme.Dark, TextColor3 = theme.White})
    tween(ScrollLeftStroke, tInfo, {Color = theme.Grey})
    tween(ScrollRightBtn, tInfo, {BackgroundColor3 = theme.Dark, TextColor3 = theme.White})
    tween(ScrollRightStroke, tInfo, {Color = theme.Grey})
    
    if clockWidgetRef then
        tween(clockWidgetRef, tInfo, {BackgroundColor3 = theme.Dark})
        tween(clockStrokeRef, tInfo, {Color = theme.Grey})
        tween(clockTimeRef, tInfo, {TextColor3 = theme.White})
        tween(clockDateRef, tInfo, {TextColor3 = theme.Light})
    end
    
    for _, tabData in ipairs(tabs) do
        tabData.Stroke.Color = theme.Grey
        tabData.Page.ScrollBarImageColor3 = theme.Grey
        if activeTab == tabData then
            tween(tabData.Button, tInfo, {BackgroundColor3 = theme.Grey, TextColor3 = theme.White})
            tabData.Stroke.Transparency = 0.2
        else
            tween(tabData.Button, tInfo, {BackgroundColor3 = theme.Dark, TextColor3 = theme.Light})
            tabData.Stroke.Transparency = 0.8
        end
    end
    
    for _, item in ipairs(registeredButtons) do
        if item.Button and item.Button.Parent then
            tween(item.Button, tInfo, {BackgroundColor3 = theme.Dark})
            if item.Button:IsA("TextButton") then
                tween(item.Button, tInfo, {TextColor3 = theme.White})
            end
        end
        if item.Stroke and item.Stroke.Parent then
            item.Stroke.Enabled = true
            item.Stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
            tween(item.Stroke, tInfo, {Color = theme.Grey, Transparency = 0})
        end
    end
end

