local function switchTab(tabData)
    if activeTab == tabData then return end
    
    if activeTab then
        if not isRainbowActive then
            tween(activeTab.Button, TweenInfo.new(0.15), {
                BackgroundColor3 = CurrentTheme.Dark,
                TextColor3 = CurrentTheme.Light
            })
            tween(activeTab.Stroke, TweenInfo.new(0.15), {Transparency = 0.8})
        end
        activeTab.Page.Visible = false
    end
    
    activeTab = tabData
    
    if not isRainbowActive then
        tween(tabData.Button, TweenInfo.new(0.15), {
            BackgroundColor3 = CurrentTheme.Grey,
            TextColor3 = CurrentTheme.White
        })
        tween(tabData.Stroke, TweenInfo.new(0.15), {Transparency = 0.2})
    end
    
    local newPage = tabData.Page
    local newScale = tabData.Scale
    
    newPage.Position = UDim2.new(0, 0, 0, 8)
    newScale.Scale = 0.96
    newPage.Visible = true
    
    tween(newScale, TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Scale = 1})
    tween(newPage, TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
        Position = UDim2.new(0, 0, 0, 0)
    })
end

