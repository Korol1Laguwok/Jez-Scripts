function updateInterfaceLanguage()
    local dict = Localizations[currentLanguage]
    if not dict then return end

    local function setText(obj, text)
        if obj and text ~= nil then obj.Text = text end
    end

    local function byName(root, name)
        if not root then return nil end
        return root:FindFirstChild(name, true)
    end

    local function stateText(prefix, active)
        return prefix .. (active and L("StatusOn") or L("StatusOff"))
    end

    -- Header / intro
    setText(LangBtn, currentLanguage)
    setText(HeaderTitle, L("Welcome") .. string.upper(username or "USER"))
    setText(SubText, L("IntroSub"))

    -- Tabs
    local tabNames = L("Tabs")
    if type(tabNames) == "table" and tabs then
        for _, tabData in ipairs(tabs) do
            setText(tabData.Button, tabNames[tabData.Key])
        end
    end

    -- Main page
    if newsCard then
        setText(newsCard:FindFirstChild("CardTitle"), L("NewsTitle"))
        setText(newsCard:FindFirstChild("CardBody"), L("NewsContent"))
        setText(byName(newsCard, "ChatBtn"), L("ChatBtn"))
    end
    if guideCard then
        setText(guideCard:FindFirstChild("CardTitle"), L("GuideTitle"))
        setText(guideCard:FindFirstChild("CardBody"), L("GuideContent"))
    end

    -- Scripts page
    if searchBox then
        searchBox.PlaceholderText = L("SearchPlaceholder")
    end
    local query = searchBox and searchBox.Text:lower():match("^%s*(.-)%s*$") or ""
    local scriptTexts = dict.ScriptsList or {}
    for _, item in ipairs(scriptCards or {}) do
        local title = scriptTexts[item.TitleKey] or item.TitleKey
        local desc = scriptTexts[item.DescKey] or item.DescKey
        setText(item.TitleLabel, title)
        setText(item.DescLabel, desc)
        setText(item.ExecBtn, L("Execute"))
        item.Title = tostring(title):lower()
        item.Desc = tostring(desc):lower()
        if item.Frame then
            item.Frame.Visible = query == ""
                or string.find(item.Title, query, 1, true) ~= nil
                or string.find(item.Desc, query, 1, true) ~= nil
        end
    end

    -- Animations page
    setText(byName(animationsPage, "AnimTitle"), L("AnimationsTitle"))
    setText(byName(animationsPage, "R6Btn"), L("R6Btn"))
    setText(byName(animationsPage, "R15Btn"), L("R15Btn"))

    -- Player page
    setText(byName(playerPage, "SpeedTitle"), L("SpeedTitle"))
    setText(byName(playerPage, "ResetBtn"), L("ResetSpeed"))
    setText(byName(playerPage, "BoostBtn"), L("BoostSpeed"))
    if updateSpeedDisplay then updateSpeedDisplay() end

    setText(byName(playerPage, "PlatformTitle"), L("PlatformTitle"))

    setText(byName(playerPage, "FlyTitle"), L("FlyTitle"))
    setText(byName(playerPage, "FlySpeedTitle"), L("FlySpeedLabel"))

    setText(byName(playerPage, "InfJumpTitle"), L("InfJumpTitle"))
    setText(byName(playerPage, "AntiAfkTitle"), L("AntiAfkTitle"))
    setText(byName(playerPage, "NoclipTitle"), L("NoclipTitle"))

    setText(byName(playerPage, "VehicleFlyTitle"), L("VehicleFlyTitle"))
    setText(byName(playerPage, "VehicleFlySpeedTitle"), L("VehicleFlySpeedLabel"))

    -- Visual page
    setText(byName(visualPage, "EspTitle"), L("EspTitle"))
    setText(byName(visualPage, "LightTitleLabel"), L("LightTitle"))
    setText(byName(visualPage, "LightBrightnessLabel"), L("LightBrightnessLabel"))
    setText(byName(visualPage, "LightRangeLabel"), L("LightRangeLabel"))
    setText(byName(visualPage, "LightToggleBtn"), stateText("LIGHT", isLightEnabled))

    setText(byName(visualPage, "GlobalFullbrightTitleLabel"), L("GlobalFullbrightTitle"))
    setText(byName(visualPage, "GlobalFullbrightToggleBtn"), stateText("WORLD", isGlobalFullbright))

    setText(byName(visualPage, "StatsBtn"), L("StatsTitle"))
