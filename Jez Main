local function tween(object, info, properties)
    local anim = TweenService:Create(object, info, properties)
    anim:Play()
    return anim
end

-- АДАПТИРОВАННОЕ TOUCH / MOUSE ПЕРЕТАСКИВАНИЕ ДЛЯ ТЕЛЕФОНОВ
local function makeDraggable(frame, isWidget)
    local dragging = false
    local dragInput = nil
    local dragStart = nil
    local startPos = nil

    frame.InputBegan:Connect(function(input)
        if isWidget then
            if frame.Name == "ClockWidget" and isClockLocked then return end
            if frame.Name == "KeystrokesWidget" and isKeystrokesLocked then return end
        end
        
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = frame.Position
            
            local endConn
            endConn = input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then 
                    dragging = false 
                    if endConn then endConn:Disconnect() end
                end
            end)
        end
    end)

    frame.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
            dragInput = input
        end
    end)

    RunService.RenderStepped:Connect(function()
        if isWidget then
            if frame.Name == "ClockWidget" and isClockLocked then dragging = false return end
            if frame.Name == "KeystrokesWidget" and isKeystrokesLocked then dragging = false return end
        end

        if dragging and dragInput then
            local delta = dragInput.Position - dragStart
            local newPos = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
            tween(frame, TweenInfo.new(0.08, Enum.EasingStyle.Sine), {Position = newPos})
        end
    end)
end

-- Вспомогательный метод зажатия для Touch / Mouse (для левитации Up/Down)
local function bindHoldButton(btn, onStart, onEnd)
    btn.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            onStart()
        end
    end)
    btn.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            onEnd()
        end
    end)
end

