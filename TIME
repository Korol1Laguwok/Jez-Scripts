    TweenService:Create(blurEffect, TweenInfo.new(0.2), {Size = 10}):Play()
    TweenService:Create(colorCorrection, TweenInfo.new(0.2), {
        TintColor = Color3.fromRGB(180, 220, 255),
        Saturation = -0.3
    }):Play()
    TweenService:Create(camera, TweenInfo.new(0.2), {FieldOfView = 82}):Play()
end

