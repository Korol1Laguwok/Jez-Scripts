local dragging, dragInput, dragStart, startPos

clockDial.InputBegan:Connect(function(input)
    if not isLocked and not isDraggingSlider and (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) then
