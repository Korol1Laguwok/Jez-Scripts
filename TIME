-- Запись движения
task.spawn(function()
    while screenGui and screenGui.Parent do
        if not isDraggingSlider then
            local char = LocalPlayer.Character
            local hrp = char and char:FindFirstChild("HumanoidRootPart")
            local hum = char and char:FindFirstChildOfClass("Humanoid")

            if hrp and hum and hum.Health > 0 then
                local currentPos = hrp.Position
                local now = os.clock()

                if not lastRecordedPos or (currentPos - lastRecordedPos).Magnitude > 0.05 then
                    table.insert(historyBuffer, {cf = hrp.CFrame, time = now})
                    if #historyBuffer > MAX_HISTORY then
                        table.remove(historyBuffer, 1)
                    end
                    currentHistoryIndex = #historyBuffer
                    lastRecordedPos = currentPos
                end
            end
        end
        task.wait(0.03)
    end
end)

-- УПРАВЛЕНИЕ ПОЛЗУНКОМ
local function updateSliderFromMouse()
    if #historyBuffer == 0 then return end

    local mousePos = UserInputService:GetMouseLocation().X
    local trackAbsPos = track.AbsolutePosition.X
    local trackAbsSize = track.AbsoluteSize.X

    local alpha = math.clamp((mousePos - trackAbsPos) / trackAbsSize, 0, 1)
    
    fill.Size = UDim2.new(alpha, 0, 1, 0)
    knob.Position = UDim2.new(alpha, 0, 0.5, 0)

    currentHistoryIndex = math.clamp(math.round(alpha * #historyBuffer), 1, #historyBuffer)
    
    local record = historyBuffer[currentHistoryIndex]
    if record then
        applySmoothRewindPosition(record.cf)
        
        local deltaSec = os.clock() - record.time
        if alpha >= 0.99 or currentHistoryIndex == #historyBuffer then
            timeLabel.Text = "⏱️ Настоящее (0.0s)"
            timeLabel.TextColor3 = Theme.Green
        else
            local mins = math.floor(deltaSec / 60)
            local secs = deltaSec % 60
            timeLabel.Text = string.format("⏱️ -%02d:%04.1fs назад", mins, secs)
            timeLabel.TextColor3 = Theme.Accent
        end

        secondPivot.Rotation = (alpha * 360 * 10) % 360
    end
end

