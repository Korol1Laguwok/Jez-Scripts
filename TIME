local function createGhostEcho(cf)
    local char = LocalPlayer.Character
    if not char then return end

    char.Archivable = true
    local ghostModel = char:Clone()
    char.Archivable = false

    local hum = ghostModel:FindFirstChildOfClass("Humanoid")
    if hum then hum:Destroy() end

    for _, v in ipairs(ghostModel:GetDescendants()) do
        if v:IsA("BasePart") then
            v.CanCollide = false
            v.Anchored = true
            v.Material = Enum.Material.Neon
            v.Color = Theme.Accent
            v.Transparency = 0.65
        elseif v:IsA("LocalScript") or v:IsA("Script") then
            v:Destroy()
        end
    end

    ghostModel:PivotTo(cf)
    ghostModel.Parent = Workspace

    task.spawn(function()
        for _ = 1, 8 do
            task.wait(0.03)
            for _, p in ipairs(ghostModel:GetChildren()) do
                if p:IsA("BasePart") then
                    p.Transparency = p.Transparency + 0.05
                end
            end
        end
        ghostModel:Destroy()
    end)
end

local function applySmoothRewindPosition(targetCF)
    local char = LocalPlayer.Character
    if not char then return end

    local hrp = char:FindFirstChild("HumanoidRootPart")

    if hrp and targetCF then
        hrp.Anchored = false
        hrp.AssemblyLinearVelocity = Vector3.zero
        hrp.AssemblyAngularVelocity = Vector3.zero

        local elevatedCF = targetCF + Vector3.new(0, 1.2, 0)
        local currentPivot = char:GetPivot()
        local smoothedCF = currentPivot:Lerp(elevatedCF, 0.45)
        
        char:PivotTo(smoothedCF)

        if os.clock() - lastGhostSpawnTime > 0.08 then
            lastGhostSpawnTime = os.clock()
            createGhostEcho(smoothedCF)
        end
    end
end

local function disableRewindFX()
    TweenService:Create(blurEffect, TweenInfo.new(0.3), {Size = 0}):Play()
    TweenService:Create(colorCorrection, TweenInfo.new(0.3), {
        TintColor = Color3.fromRGB(255, 255, 255),
        Saturation = 0
    }):Play()
    TweenService:Create(camera, TweenInfo.new(0.3), {FieldOfView = 70}):Play()

    local char = LocalPlayer.Character
    if char then
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if hrp then
            hrp.Anchored = false
            hrp.AssemblyLinearVelocity = Vector3.zero
            hrp.AssemblyAngularVelocity = Vector3.zero
        end
    end
end

