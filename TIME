-- ----------------------------------------------------------------------------
-- 🎬 МЕДЛЕННАЯ КАТСЦЕНА С ГАРАНТИРОВАННЫМ ЗВУКОМ ТИКАНИЯ И КОЛОКОЛОВ
-- ----------------------------------------------------------------------------
local function playMidnightClockCutscene()
    local char = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
    local hrp = char:WaitForChild("HumanoidRootPart")

    camera.CameraType = Enum.CameraType.Scriptable

    local hrpPos = hrp.Position
    local hrpLook = hrp.CFrame.LookVector
    local hrpRight = hrp.CFrame.RightVector

    local clockPos = hrpPos + (hrpLook * 18) + Vector3.new(0, 8, 0)
    
    local clockModel = createGiantMidnightClock()
    clockModel.Parent = Workspace
    
    local base = clockModel.PrimaryPart
    local hHand = clockModel:FindFirstChild("HourHand")
    local mHand = clockModel:FindFirstChild("MinuteHand")
    local sHand = clockModel:FindFirstChild("SecondHand")

    -- Поворот ПО ЧАСОВОЙ СТРЕЛКЕ (от -30° слева около 11 часов плавно вверх к 0° на 12)
    local function updateClockTransforms(secondAngle)
        if base then
            base.CFrame = CFrame.lookAt(clockPos, hrpPos + Vector3.new(0, 3, 0))
        end
        
        if base and hHand then
            hHand.CFrame = base.CFrame * CFrame.new(0, 0, -0.25) * CFrame.Angles(0, 0, 0) * CFrame.new(0, 1.6, 0)
        end
        if base and mHand then
            mHand.CFrame = base.CFrame * CFrame.new(0, 0, -0.30) * CFrame.Angles(0, 0, 0) * CFrame.new(0, 2.2, 0)
        end
        if base and sHand then
            sHand.CFrame = base.CFrame * CFrame.new(0, 0, -0.35) * CFrame.Angles(0, 0, math.rad(secondAngle)) * CFrame.new(0, 2.5, 0)
        end
    end

    updateClockTransforms(-30)

    -- Камера: Эпичный ракурс
    local camPos = hrpPos + (hrpLook * 4) + (hrpRight * -5) + Vector3.new(0, 2, 0)
    camera.CFrame = CFrame.lookAt(camPos, clockPos)
    camera.FieldOfView = 60

    blurEffect.Size = 6
    colorCorrection.TintColor = Color3.fromRGB(180, 220, 255)
    colorCorrection.Saturation = -0.2

    -- 1. Медленный отсчёт с задержками (по часовой стрелке)
    local steps = {-30, -24, -18, -12, -6, -2, 0}
    local delays = {0.8, 0.9, 1.1, 1.3, 1.5, 1.8, 0.3}

    for i, angle in ipairs(steps) do
        updateClockTransforms(angle)
        
        -- Чёткое тиканье стрелки!
        playTick()

        TweenService:Create(blurEffect, TweenInfo.new(0.25), {Size = 14}):Play()
        task.wait(delays[i] * 0.35)
        TweenService:Create(blurEffect, TweenInfo.new(0.35), {Size = 6}):Play()
        task.wait(delays[i] * 0.65)
    end

    -- 2. 🎉 ПОЛНОЧЬ! 12:00 - УДАР КУРАНТОВ И ТОРЖЕСТВЕННЫЙ ЗВОН КОЛОКОЛОВ!
    updateClockTransforms(0)

    playBell()

    TweenService:Create(blurEffect, TweenInfo.new(0.4), {Size = 35}):Play()
    TweenService:Create(colorCorrection, TweenInfo.new(0.4), {
        TintColor = Color3.fromRGB(255, 255, 255),
        Saturation = 1.0
    }):Play()

    TweenService:Create(camera, TweenInfo.new(1.6, Enum.EasingStyle.Sine, Enum.EasingDirection.Out), {
        CFrame = CFrame.lookAt(hrpPos + (hrpLook * 8) + Vector3.new(0, 5, 0), clockPos),
        FieldOfView = 45
    }):Play()

    task.wait(1.8)

    -- 3. Растворение курантов
    for _, p in ipairs(clockModel:GetChildren()) do
        if p:IsA("BasePart") then
            TweenService:Create(p, TweenInfo.new(0.7), {
                Transparency = 1,
                Size = Vector3.new(0.1, 0.1, 0.1)
            }):Play()
        end
    end

    task.wait(0.7)
    clockModel:Destroy()

    -- 4. Завершение катсцены
    TweenService:Create(blurEffect, TweenInfo.new(0.5), {Size = 0}):Play()
    TweenService:Create(colorCorrection, TweenInfo.new(0.5), {
        TintColor = Color3.fromRGB(255, 255, 255),
        Saturation = 0
    }):Play()
    TweenService:Create(camera, TweenInfo.new(0.5), {FieldOfView = 70}):Play()

    task.wait(0.3)
    camera.CameraType = Enum.CameraType.Custom

    -- 5. Появление интерфейса
    mainFrame.Visible = true
    mainFrame.Position = UDim2.new(1, -20, 1, -10)
    
    TweenService:Create(mainFrame, TweenInfo.new(0.5, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
        Position = UDim2.new(1, -20, 1, -20)
    }):Play()
end

-- Запуск новогодней катсцены
