-- ----------------------------------------------------------------------------
-- КАСКАДНАЯ АНИМАЦИЯ РАЗЛОМА (1 -> 4 -> 8)
-- ----------------------------------------------------------------------------
local function playCascadeExplosion(target, hitPos)
    local parts = {}
    if target:IsA("BasePart") then table.insert(parts, target) end
    for _, desc in ipairs(target:GetDescendants()) do
        if desc:IsA("BasePart") then table.insert(parts, desc) end
    end

    local blastCenter = hitPos or (parts[1] and parts[1].Position) or Vector3.zero

    for _, part in ipairs(parts) do
        task.spawn(function()
            local origCF = part.CFrame
            local origSize = part.Size
            local color = part.Color
            local material = part.Material

            -- ФАЗА 1: Разделение 1 -> 4 основных блока
            local stage1Pieces = {}
            local subSize1 = Vector3.new(origSize.X / 2, origSize.Y, origSize.Z / 2)
            
            for x = -1, 1, 2 do
                for z = -1, 1, 2 do
                    local p = Instance.new("Part")
                    p.Size = subSize1
                    p.Color = color
                    p.Material = material
                    p.Transparency = part.Transparency
                    p.Anchored = true
                    p.CanCollide = false
                    p.CanTouch = false
                    p.CanQuery = false
                    
                    local localOffset = Vector3.new((x * origSize.X) / 4, 0, (z * origSize.Z) / 4)
                    p.CFrame = origCF * CFrame.new(localOffset)
                    p.Parent = Workspace
                    
                    table.insert(stage1Pieces, {part = p, offset = localOffset, origCF = origCF})
                end
            end

            -- Медленное расхождение 1-й фазы (4 куска)
            for _, item in ipairs(stage1Pieces) do
                local dir = item.offset.Unit
                if dir.Magnitude == 0 or tostring(dir.X) == "nan" then dir = Vector3.new(0, 1, 0) end
                local targetCF = item.origCF * CFrame.new(item.offset * 1.6) * CFrame.Angles(math.rad(dir.X * 12), math.rad(dir.Z * 12), 0)
                tween(item.part, TweenInfo.new(0.5, Enum.EasingStyle.Cubic, Enum.EasingDirection.Out), {
                    CFrame = targetCF
                })
            end

            -- Задержка 0.45 сек, чтобы разлом был отчетливо виден!
            task.wait(0.45)

            -- ФАЗА 2: Разделение каждой из 4 частей еще пополам (4 -> 8 осколков)
            for _, item in ipairs(stage1Pieces) do
                local p1 = item.part
                if p1 and p1.Parent then
                    local currentCF = p1.CFrame
                    local curSize = p1.Size
                    p1:Destroy() -- Заменяем на 2 более мелких кусочка

                    for y = -1, 1, 2 do
                        local subP = Instance.new("Part")
                        subP.Size = Vector3.new(curSize.X, curSize.Y / 2, curSize.Z)
                        subP.Color = color
                        subP.Material = material
                        subP.Transparency = 0.05
                        subP.Anchored = true
                        subP.CanCollide = false
                        subP.CanTouch = false
                        subP.CanQuery = false

                        local yOffset = Vector3.new(0, (y * curSize.Y) / 4, 0)
                        subP.CFrame = currentCF * CFrame.new(yOffset)
                        subP.Parent = Workspace

                        -- Неоновый отблеск разлома
                        local hl = Instance.new("Highlight", subP)
                        hl.FillColor = Theme.PortalGreen
                        hl.OutlineColor = Theme.Accent
                        hl.FillTransparency = 0.4

                        -- Медленная финальная фаза разлёта и плавного растворения
                        local moveDir = (subP.Position - blastCenter)
                        if moveDir.Magnitude < 0.1 then moveDir = Vector3.new(0, 1, 0) else moveDir = moveDir.Unit end
                        
                        local finalCF = subP.CFrame * CFrame.new(moveDir * math.random(5, 10) + Vector3.new(0, math.random(2, 5), 0)) * CFrame.Angles(
                            math.rad(math.random(-90, 90)),
                            math.rad(math.random(-90, 90)),
                            math.rad(math.random(-90, 90))
                        )

                        local anim = tween(subP, TweenInfo.new(1.3, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
                            CFrame = finalCF,
                            Transparency = 1,
                            Size = subP.Size * 0.2
                        })
                        anim.Completed:Connect(function() subP:Destroy() end)
                    end
                end
            end
        end)
    end
end

-- ВЫЗОВ СБОРКИ ПРИ ВОССТАНОВЛЕНИИ
local function playVisualReassembly(targetData, onComplete)
    local partsInfo = targetData.partsInfo or {}
    local total = #partsInfo
    if total == 0 then
        if onComplete then onComplete() end
        return
    end

    local count = 0
    for _, info in ipairs(partsInfo) do
        local part = info.part
        if part then
            local clone = part:Clone()
            clone.CanCollide = false
            clone.CanTouch = false
            clone.CanQuery = false
            clone.Anchored = true
            clone.Transparency = 0.85
            clone.Parent = Workspace

            local hl = Instance.new("Highlight", clone)
            hl.FillColor = Theme.PortalGreen
            hl.OutlineColor = Theme.Accent
            hl.FillTransparency = 0.4

            local offset = Vector3.new(math.random(-14, 14), math.random(6, 16), math.random(-14, 14))
            clone.CFrame = info.cframe + offset

            local anim = tween(clone, TweenInfo.new(0.55, Enum.EasingStyle.Quart, Enum.EasingDirection.In), {
                CFrame = info.cframe,
                Transparency = 0
            })

            anim.Completed:Connect(function()
                clone:Destroy()
                count = count + 1
                if count >= total and onComplete then
                    onComplete()
                end
            end)
        else
            count = count + 1
            if count >= total and onComplete then
                onComplete()
            end
        end
    end
end

-- ВОССТАНОВЛЕНИЕ ОБЪЕКТОВ
local function restoreSingleObject(obj, animate)
    local data = deletedObjects[obj]
    if not data then return end
    
    if animate then
        playVisualReassembly(data, function()
            if obj and data.parent then
                obj.Parent = data.parent
            end
        end)
    else
        if obj and data.parent then
            obj.Parent = data.parent
        end
    end

    deletedObjects[obj] = nil
end

local function restoreAllObjects(animate)
    local restoredCount = 0
    for obj in pairs(deletedObjects) do
        restoreSingleObject(obj, animate)
        restoredCount = restoredCount + 1
    end
    table.clear(deletedObjects)
    return restoredCount
end

local function cleanupScript()
    isEnabled = false
    hoverHighlight.Enabled = false
    hoverHighlight.Adornee = nil
    
    for _, conn in ipairs(connections) do
        if conn then conn:Disconnect() end
    end
    table.clear(connections)
    
    restoreAllObjects(false)
end

