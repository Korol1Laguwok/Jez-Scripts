local function isSafeToHide(target)
    if not target or target == Workspace or target == workspace.Terrain then return false end
    if LocalPlayer.Character and target:IsDescendantOf(LocalPlayer.Character) then return false end
    if target:IsA("Terrain") or target:IsA("Camera") then return false end
    return true
end

local function hideObject(target)
    if not isSafeToHide(target) or deletedObjects[target] then return end

    local originalParent = target.Parent
    deletedObjects[target] = originalParent
    target.Parent = nil

    local itemBtn = Instance.new("TextButton", scrollList)
    itemBtn.Size = UDim2.new(1, 0, 0, 24)
    itemBtn.BackgroundColor3 = Theme.Dark
    itemBtn.Text = "  [Вернуть] " .. string.sub(target.Name, 1, 15)
    itemBtn.TextColor3 = Theme.White
    itemBtn.TextSize = 11
    itemBtn.Font = Enum.Font.Gotham
    itemBtn.TextXAlignment = Enum.TextXAlignment.Left
    itemBtn.ZIndex = 3
    Instance.new("UICorner", itemBtn).CornerRadius = UDim.new(0, 5)

    itemBtn.MouseButton1Click:Connect(function()
        if target and deletedObjects[target] then
            target.Parent = deletedObjects[target]
            deletedObjects[target] = nil
        end
        itemBtn:Destroy()
    end)
end

restoreAllBtn.MouseButton1Click:Connect(function()
    for obj, originalParent in pairs(deletedObjects) do
        if obj and originalParent then
            obj.Parent = originalParent
        end
    end
    table.clear(deletedObjects)

    for _, child in ipairs(scrollList:GetChildren()) do
        if child:IsA("TextButton") then
            child:Destroy()
        end
    end
end)

local function getTargetUnderMouse()
    local mousePosition = UserInputService:GetMouseLocation()
    local unitRay = Camera:ViewportPointToRay(mousePosition.X, mousePosition.Y)

    local raycastParams = RaycastParams.new()
    raycastParams.FilterType = Enum.RaycastFilterType.Exclude
    raycastParams.RespectCanCollide = false

    if LocalPlayer.Character then
        raycastParams.FilterDescendantsInstances = { LocalPlayer.Character }
    end

    local result = Workspace:Raycast(unitRay.Origin, unitRay.Direction * 1000, raycastParams)
    if result and result.Instance and isSafeToHide(result.Instance) then
        return result.Instance
    end

    return nil
end

UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end

    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        if isEnabled and not isClickProcessed and UserInputService:IsKeyDown(Enum.KeyCode.R) then
            isClickProcessed = true
            
            local target = getTargetUnderMouse()
            if target then
                hideObject(target)
            end
        end
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        isClickProcessed = false
    end
end)

tween(mainScale, TweenInfo.new(0.4, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Scale = 1})
