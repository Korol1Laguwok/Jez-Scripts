local function isSafeToHide(target)
    if not target or target == Workspace or target == workspace.Terrain then return false end
    if LocalPlayer.Character and target:IsDescendantOf(LocalPlayer.Character) then return false end
    if target:IsA("Terrain") or target:IsA("Camera") then return false end
    return true
end

-- УДАЛЕНИЕ И СБОР ДАННЫХ ДЛЯ ЭФФЕКТОВ
local function applyHideAction(target, hitPos)
    if not isSafeToHide(target) or deletedObjects[target] then return end

    local partsInfo = {}
    if target:IsA("BasePart") then
        table.insert(partsInfo, { part = target, cframe = target.CFrame })
    end
    for _, desc in ipairs(target:GetDescendants()) do
        if desc:IsA("BasePart") then
            table.insert(partsInfo, { part = desc, cframe = desc.CFrame })
        end
    end

    playCascadeExplosion(target, hitPos)

    local originalParent = target.Parent
    deletedObjects[target] = { parent = originalParent, partsInfo = partsInfo }
    target.Parent = nil

    notify("Скрыто: " .. string.sub(target.Name, 1, 16), Theme.Red)
    updateCounter()

    local itemBtn = Instance.new("TextButton", scrollList)
    itemBtn.Size = UDim2.new(1, 0, 0, 26)
    itemBtn.BackgroundColor3 = Theme.Background
    itemBtn.Text = " ↩ [Вернуть] " .. string.sub(target.Name, 1, 14)
    itemBtn.TextColor3 = Theme.Text
    itemBtn.TextSize = 10.5
    itemBtn.Font = Enum.Font.GothamMedium
    itemBtn.TextXAlignment = Enum.TextXAlignment.Left
    itemBtn.ZIndex = 3
    Instance.new("UICorner", itemBtn).CornerRadius = UDim.new(0, 6)

    itemBtn.MouseButton1Click:Connect(function()
        restoreSingleObject(target, true)
        updateCounter()
        notify("Собрано: " .. string.sub(target.Name, 1, 14), Theme.Green)
        itemBtn:Destroy()
    end)
end

