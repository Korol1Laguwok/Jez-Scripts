-- Генерация случайных имён UI для защиты от античитов
local function getRandomName(length)
    local str = ""
    for _ = 1, length or math.random(8, 14) do
        str = str .. string.char(math.random(97, 122))
    end
    return str
end

local function tween(instance, info, properties)
    local anim = TweenService:Create(instance, info, properties)
    anim:Play()
    return anim
end

