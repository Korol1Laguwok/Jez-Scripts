    recDot.Size = Vector3.new(0.12, 0.12, 0.05)
    recDot.CFrame = cameraMount.CFrame * CFrame.new(0.18, 0.1, -0.26)
    recDot.Material = Enum.Material.Neon
    recDot.Color = Theme.Red
    recDot.CanCollide = false
    recDot.Anchored = true
    recDot.Parent = model

    local motorSound = Instance.new("Sound")
    motorSound.Name = "RotorSound"
    motorSound.SoundId = "rbxassetid://9114223179"
    motorSound.Volume = 0.8
    motorSound.Looped = true
    motorSound.RollOffMaxDistance = 80
    motorSound.Parent = body
    motorSound:Play()

    local arms = {}
    local rotors = {}
    local offsets = {
        Vector3.new(1.4, 0.1, 1.4),
        Vector3.new(-1.4, 0.1, 1.4),
        Vector3.new(1.4, 0.1, -1.4),
        Vector3.new(-1.4, 0.1, -1.4)
    }

    for _, off in ipairs(offsets) do
        local arm = Instance.new("Part")
        arm.Size = Vector3.new(0.15, 0.15, off.Magnitude)
        arm.CFrame = CFrame.lookAt(body.Position, body.Position + off) * CFrame.new(0, 0, -off.Magnitude/2)
        arm.Material = Enum.Material.SmoothPlastic
        arm.Color = Color3.fromRGB(15, 15, 18)
        arm.CanCollide = false
        arm.Anchored = true
        arm.Parent = model

        local rotor = Instance.new("Part")
        rotor.Size = Vector3.new(1.3, 0.03, 0.12)
        rotor.CFrame = body.CFrame * CFrame.new(off + Vector3.new(0, 0.14, 0))
        rotor.Material = Enum.Material.SmoothPlastic
        rotor.Color = Color3.fromRGB(240, 240, 250)
        rotor.CanCollide = false
        rotor.Anchored = true
        rotor.Parent = model

        table.insert(arms, {Part = arm, Offset = off})
        table.insert(rotors, {Part = rotor, Offset = off})
    end

    model.PrimaryPart = body
    model.Parent = workspace

    return model, body, jezPlate, cameraMount, lampBody, lampLens, recDot, flashlight, arms, rotors, motorSound
end

