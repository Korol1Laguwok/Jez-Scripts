local function lockCurrentDrone()
    currentControllingDrone = nil
    setCharacterMovement(true)

    if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid") then
        Camera.CameraType = Enum.CameraType.Custom
        Camera.CameraSubject = LocalPlayer.Character.Humanoid
    end
end

-- ===== ВЗРЫВ =====
local function explodeDrone(drone, idx)
    if drone and drone.Part then
        local pos = drone.Part.Position

        local exp = Instance.new("Explosion")
        exp.Position = pos
        exp.BlastRadius = 10
        exp.BlastPressure = 0
        exp.Parent = workspace

        local snd = Instance.new("Sound")
        snd.SoundId = "rbxassetid://142070127"
        snd.Volume = 2
        snd.Parent = SoundService
        snd:Play()
        snd.Ended:Connect(function() snd:Destroy() end)

        if currentControllingDrone == drone then
            lockCurrentDrone()
        end

        if drone.Model then drone.Model:Destroy() end
        table.remove(activeDrones, idx)
        refreshDroneFeedsUI()
        setCharacterMovement(true)
        ActiveCountLabel.Text = L("ActiveCount") .. tostring(#activeDrones) .. " / " .. tostring(maxDrones)
    end
end

-- КЛАВИШИ УПРАВЛЕНИЯ
UserInputService.InputBegan:Connect(function(input, processed)
    if processed or not isScriptActive then return end
    if input.KeyCode == Enum.KeyCode.E then
        spawnDrone()
    elseif input.KeyCode == Enum.KeyCode.F then
        lockCurrentDrone()
    elseif input.KeyCode == Enum.KeyCode.L then
        if currentControllingDrone and currentControllingDrone.Light then
            currentControllingDrone.Light.Enabled = not currentControllingDrone.Light.Enabled
            currentControllingDrone.LampLens.Color = currentControllingDrone.Light.Enabled and Color3.fromRGB(255, 255, 180) or Color3.fromRGB(80, 80, 80)
        end
    end
end)

