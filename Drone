local function tween(object, info, properties)
    local anim = TweenService:Create(object, info, properties)
    anim:Play()
    return anim
end

-- ===== АДАПТИВНОЕ ПЕРЕТАСКИВАНИЕ С ИСКЛЮЧЕНИЕМ ДЛЯ ПОЛЗУНКА =====
local function makeDraggable(frame)
    local dragging, dragInput, dragStart, startPos = false, nil, nil, nil

    frame.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            local mousePos = input.Position
            local speedCard = frame:FindFirstChild("BodyContainer") and frame.BodyContainer:FindFirstChild("SpeedControlCard")
            if speedCard then
                local cardPos = speedCard.AbsolutePosition
                local cardSize = speedCard.AbsoluteSize
                if mousePos.X >= cardPos.X and mousePos.X <= cardPos.X + cardSize.X and
                   mousePos.Y >= cardPos.Y and mousePos.Y <= cardPos.Y + cardSize.Y then
                    return 
                end
            end

            dragging = true
            dragStart = input.Position
            startPos = frame.Position
            
            local endConn
            endConn = input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then 
                    dragging = false 
                    if endConn then endConn:Disconnect() end
                end
            end)
        end
    end)

    frame.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
            dragInput = input
        end
    end)

    RunService.RenderStepped:Connect(function()
        if dragging and dragInput and isScriptActive then
            local delta = dragInput.Position - dragStart
            local newPos = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
            tween(frame, TweenInfo.new(0.08, Enum.EasingStyle.Sine), {Position = newPos})
        end
    end)
end

