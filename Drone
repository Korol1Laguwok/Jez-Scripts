RunService.RenderStepped:Connect(function()
    if not isScriptActive then return end

    for _, drone in ipairs(activeDrones) do
        if drone and drone.Model and drone.Model.Parent then
            local bCF = drone.Part.CFrame

            drone.JezPlate.CFrame = bCF * CFrame.new(0, 0.22, 0)
            drone.Mount.CFrame = bCF * CFrame.new(0, -0.2, -0.7)
            drone.LampBody.CFrame = drone.Mount.CFrame * CFrame.new(0, -0.25, 0)
            drone.LampLens.CFrame = drone.LampBody.CFrame * CFrame.new(0, 0, -0.2)
            drone.RecDot.CFrame = drone.Mount.CFrame * CFrame.new(0.18, 0.1, -0.26)

            for _, aData in ipairs(drone.Arms) do
                aData.Part.CFrame = CFrame.lookAt(bCF.Position, bCF.Position + (bCF:VectorToWorldSpace(aData.Offset))) * CFrame.new(0, 0, -aData.Offset.Magnitude/2)
            end

            for idx, rData in ipairs(drone.Rotors) do
                local dir = (idx % 2 == 0) and 1 or -1
                rData.Part.CFrame = bCF * CFrame.new(rData.Offset + Vector3.new(0, 0.14, 0)) * CFrame.Angles(0, math.rad(tick() * 2200 * dir % 360), 0)
            end
        end
    end
end)

-- ===== СПАВН И СВЕРХБЫСТРОЕ УПРАВЛЕНИЕ =====
local function spawnDrone()
    if not isScriptActive then return end

    if currentControllingDrone ~= nil then
        ActiveCountLabel.Text = L("InFlightError")
        task.delay(2, function()
            ActiveCountLabel.Text = L("ActiveCount") .. tostring(#activeDrones) .. " / " .. tostring(maxDrones)
        end)
        return
    end

    if #activeDrones >= maxDrones then
        ActiveCountLabel.Text = L("MaxReached")
        task.delay(2, function()
            ActiveCountLabel.Text = L("ActiveCount") .. tostring(#activeDrones) .. " / " .. tostring(maxDrones)
        end)
        return
    end

    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    setCharacterMovement(false)
    SpeedHud.Visible = true

    local spawnPos = hrp.Position + (hrp.CFrame.LookVector * 4) + Vector3.new(0, 3, 0)
    local droneModel, dronePart, jezPlate, camMount, lampBody, lampLens, recDot, flashlight, arms, rotors, motorSound = createUnifiedDrone(spawnPos)

    local droneData = {
        Model = droneModel,
        Part = dronePart,
        JezPlate = jezPlate,
        Mount = camMount,
        LampBody = lampBody,
        LampLens = lampLens,
        Light = flashlight,
        RecDot = recDot,
        Arms = arms,
        Rotors = rotors,
        Sound = motorSound,
        ID = #activeDrones + 1,
        CustomName = L("DroneDefaultName") .. tostring(#activeDrones + 1),
        IsPinned = false
    }

    table.insert(activeDrones, droneData)
    currentControllingDrone = droneData

    ActiveCountLabel.Text = L("ActiveCount") .. tostring(#activeDrones) .. " / " .. tostring(maxDrones)
    Camera.CameraType = Enum.CameraType.Scriptable

    local yaw = 0
    local pitch = 0
    local lastPos = dronePart.Position
    local smoothedKmh = 0
    local lastSpeedUpdate = os.clock()

    task.spawn(function()
        while droneData.Model and droneData.Model.Parent do
            recDot.Transparency = 0
            task.wait(0.4)
            recDot.Transparency = 1
            task.wait(0.4)
        end
    end)

    local moveConn
    moveConn = RunService.RenderStepped:Connect(function(dt)
        if currentControllingDrone == droneData and droneData.Model and droneData.Model.Parent then
            
            -- Вычисление разгона и сглаживания
            local currentPos = dronePart.Position
            local dist = (currentPos - lastPos).Magnitude
            local studsPerSec = dist / dt
            local rawKmh = studsPerSec * 0.28
            
            smoothedKmh = smoothedKmh + (rawKmh - smoothedKmh) * 0.2
            lastPos = currentPos

            if os.clock() - lastSpeedUpdate >= 0.1 then
                lastSpeedUpdate = os.clock()
                SpeedText.Text = string.format("⚡ %.1f km/h", math.clamp(smoothedKmh, 0, droneMaxSpeedKmh))
            end

            if UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton2) then
                UserInputService.MouseBehavior = Enum.MouseBehavior.LockCurrentPosition
                local delta = UserInputService:GetMouseDelta()
                yaw = yaw - delta.X * 0.25
                pitch = math.clamp(pitch - delta.Y * 0.25, -75, 75)
            else
                UserInputService.MouseBehavior = Enum.MouseBehavior.Default
            end

            local rotationCF = CFrame.Angles(0, math.rad(yaw), 0) * CFrame.Angles(math.rad(pitch), 0, 0)
            dronePart.CFrame = CFrame.new(dronePart.Position) * rotationCF

            local moveVector = Vector3.zero
            if UserInputService:IsKeyDown(Enum.KeyCode.W) then moveVector = moveVector + dronePart.CFrame.LookVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.S) then moveVector = moveVector - dronePart.CFrame.LookVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.A) then moveVector = moveVector - dronePart.CFrame.RightVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.D) then moveVector = moveVector + dronePart.CFrame.RightVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.Space) then moveVector = moveVector + Vector3.new(0, 1, 0) end
            if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then moveVector = moveVector - Vector3.new(0, 1, 0) end

            if moveVector.Magnitude > 0 then
                -- Увеличенный множитель скорости под режим до 500 км/ч
                local studSpeedMultiplier = (droneMaxSpeedKmh / 0.28)
                dronePart.Position = dronePart.Position + (moveVector.Unit * studSpeedMultiplier * dt)
            end

            Camera.CFrame = dronePart.CFrame * CFrame.new(0, -0.1, -0.8)
        else
            if moveConn then moveConn:Disconnect() end
        end
    end)

    refreshDroneFeedsUI()
end

