local isStopped = false
local isRunning = false

-- Симуляция загрузки
task.spawn(function()
    CreateTween(ProgressBar, TweenInfo.new(0.5, Enum.EasingStyle.Quad), {Size = UDim2.new(0.4, 0, 1, 0)})
    task.wait(0.5)
    LoadStatus.Text = "Подготовка..."
    
    CreateTween(ProgressBar, TweenInfo.new(0.6, Enum.EasingStyle.Quad), {Size = UDim2.new(0.8, 0, 1, 0)})
    task.wait(0.6)
    LoadStatus.Text = "Готово!"
    
    CreateTween(ProgressBar, TweenInfo.new(0.3, Enum.EasingStyle.Quad), {Size = UDim2.new(1, 0, 1, 0)})
    task.wait(0.3)
    
    -- Исчезновение экрана загрузки
    CreateTween(LoadingFrame, TweenInfo.new(0.3, Enum.EasingStyle.Quad), {BackgroundTransparency = 1})
    CreateTween(LoadTitle, TweenInfo.new(0.2, Enum.EasingStyle.Quad), {TextTransparency = 1})
    CreateTween(LoadStatus, TweenInfo.new(0.2, Enum.EasingStyle.Quad), {TextTransparency = 1})
    CreateTween(ProgressBarBG, TweenInfo.new(0.2, Enum.EasingStyle.Quad), {BackgroundTransparency = 1})
    CreateTween(ProgressBar, TweenInfo.new(0.2, Enum.EasingStyle.Quad), {BackgroundTransparency = 1})
    CreateTween(LoadingStroke, TweenInfo.new(0.2, Enum.EasingStyle.Quad), {Transparency = 1})
    
    task.wait(0.3)
    LoadingFrame:Destroy()
    
    -- Плавное открытие основного окна
    MainFrame.Visible = true
    CreateTween(MainFrame, TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {BackgroundTransparency = 0})
    
    ShowNotification("J-LUCKY BLOCK", "Скрипт активирован!")
end)

