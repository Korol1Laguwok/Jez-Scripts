local function UnloadGUI()
    stopLoop()
    toggleNoclip(false)
    isLuckyStopped = true
    isLuckyRunning = false
    ContextActionService:UnbindAction("BlockHotbarTyping")
    if ScreenGui and ScreenGui.Parent then
        ScreenGui:Destroy()
    end
    getgenv().JezSystemUnload = nil
end

getgenv().JezSystemUnload = UnloadGUI

local UnloadBtn = createButton("🗑️ УДАЛИТЬ GUI ПОЛНОСТЬЮ", function()
    UnloadGUI()
end)
UnloadBtn.BackgroundColor3 = Color3.fromRGB(55, 25, 30)

-- Блокировка переключения хотбара клавишами (1-0) при вводе текста
local HotbarKeys = {
    Enum.KeyCode.One, Enum.KeyCode.Two, Enum.KeyCode.Three, Enum.KeyCode.Four, Enum.KeyCode.Five,
    Enum.KeyCode.Six, Enum.KeyCode.Seven, Enum.KeyCode.Eight, Enum.KeyCode.Nine, Enum.KeyCode.Zero
}

local function bindHotbarBlock()
    ContextActionService:BindActionAtPriority(
        "BlockHotbarTyping",
        function() return Enum.ContextActionResult.Sink end,
        false, 10000, unpack(HotbarKeys)
    )
end

local function unbindHotbarBlock()
    ContextActionService:UnbindAction("BlockHotbarTyping")
end

DistanceBox.Focused:Connect(bindHotbarBlock)
DistanceBox.FocusLost:Connect(unbindHotbarBlock)
AmountInput.Focused:Connect(bindHotbarBlock)
AmountInput.FocusLost:Connect(unbindHotbarBlock)

