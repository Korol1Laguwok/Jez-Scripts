-- ЛОГИКА NOCLIP (БЕЗ ОТКИДЫВАНИЯ)
local isNoclipActive = false
local noclipConnection = nil
local noclipBtn

local function toggleNoclip(state)
    if state == nil then isNoclipActive = not isNoclipActive else isNoclipActive = state end
    if isNoclipActive then
        if not noclipConnection then
            noclipConnection = RunService.Stepped:Connect(function()
                local char = LocalPlayer.Character
                if char then
                    for _, part in ipairs(char:GetDescendants()) do
                        if part:IsA("BasePart") then
                            part.CanCollide = false
                        end
                    end
                end
            end)
        end
        if noclipBtn then
            noclipBtn.Text = "👻 Без откидывания (Noclip): ВКЛ"
            noclipBtn.TextColor3 = Color3.fromRGB(0, 230, 120)
        end
    else
        if noclipConnection then
            noclipConnection:Disconnect()
            noclipConnection = nil
        end
        local char = LocalPlayer.Character
        if char then
            for _, part in ipairs(char:GetDescendants()) do
                if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" then
                    part.CanCollide = true
                end
            end
        end
        if noclipBtn then
            noclipBtn.Text = "👻 Без откидывания (Noclip): ВЫКЛ"
            noclipBtn.TextColor3 = Color3.fromRGB(235, 235, 245)
        end
    end
end

noclipBtn = createButton("👻 Без откидывания (Noclip): ВЫКЛ", function()
