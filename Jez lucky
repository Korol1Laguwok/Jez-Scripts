local BlockEvents = {
    "SpawnLuckyBlock", "SpawnSuperBlock", "SpawnDiamondBlock",
    "SpawnGalaxyBlock", "SpawnRainbowBlock", "SpawnVoidBlock"
}

local isLuckyRunning = false
local isLuckyStopped = false

local StartBtn = createButton("🚀 ЗАПУСТИТЬ СПАВН БЛОКОВ", function(btn)
    if isLuckyRunning then return end
    local total = tonumber(AmountInput.Text)
    if not total or total <= 0 then return end
    
    isLuckyRunning = true
    isLuckyStopped = false
    
    task.spawn(function()
        for i = 1, total do
            if isLuckyStopped then break end
            
            local eventName = BlockEvents[(i - 1) % #BlockEvents + 1]
            local remote = ReplicatedStorage:FindFirstChild(eventName)
            if remote then
                remote:FireServer()
                btn.Text = "СПАВН: " .. i .. " / " .. total
            end
            if i % 20 == 0 then
                task.wait(math.random(5, 10) / 100)
            end
        end
        
        btn.Text = "ГОТОВО!"
        task.wait(1.5)
        btn.Text = "🚀 ЗАПУСТИТЬ СПАВН БЛОКОВ"
        isLuckyRunning = false
    end)
end)

createButton("⛔ ОСТАНОВИТЬ СПАВН", function()
    isLuckyStopped = true
end)

