            DisplayLabel.TextColor3 = Theme.TextPrimary
            DisplayLabel.Font = Enum.Font.GothamBold
            DisplayLabel.TextSize = 12
            DisplayLabel.TextXAlignment = Enum.TextXAlignment.Left

            -- Юзернейм (@username)
            local UserLabel = Instance.new("TextLabel", Btn)
            UserLabel.Size = UDim2.new(1, -50, 0, 14)
            UserLabel.Position = UDim2.new(0, 45, 0, 22)
            UserLabel.BackgroundTransparency = 1
            UserLabel.Text = "@" .. p.Name
            UserLabel.TextColor3 = Theme.TextSecondary
            UserLabel.Font = Enum.Font.Gotham
            UserLabel.TextSize = 10
            UserLabel.TextXAlignment = Enum.TextXAlignment.Left

            -- Плавная анимация при наведении
