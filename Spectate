-- Функция определения текущего действия игрока
local function getPlayerAction(targetPlayer)
    if not targetPlayer or not targetPlayer.Character then 
        return "Нет персонажа ⏳" 
    end
    
    local char = targetPlayer.Character
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum then 
        return "Загрузка... ⏳" 
    end

    if hum.Health <= 0 then
        return "Умер 💀"
    elseif hum.Sit then
        return "Сидит 🪑"
    end

    local state = hum:GetState()
    if state == Enum.HumanoidStateType.Jumping then
        return "Прыгает 🥾"
    elseif state == Enum.HumanoidStateType.Freefall then
        return "Падает 🪂"
    elseif state == Enum.HumanoidStateType.Swimming then
        return "Плывет 🏊"
    elseif state == Enum.HumanoidStateType.Climbing then
        return "Карабкается 🪜"
    end

    if hum.MoveDirection.Magnitude > 0.1 then
        if hum.WalkSpeed > 20 then
            return "Бежит 🏃"
        else
            return "Ходит 🚶"
        end
    else
        return "Стоит 🧍"
    end
end

-- Переменные слежения
local currentIndex = 0
local isSpectating = false

local function getOtherPlayers()
    local list = {}
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer then
            table.insert(list, p)
        end
    end
    return list
end

local function unspectate()
    isSpectating = false
    currentIndex = 0
    if LocalPlayer.Character then
        local myHum = LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
        if myHum then
            Camera.CameraSubject = myHum
        end
    end
    DisplayNameLabel.Text = LocalPlayer.DisplayName
    UsernameLabel.Text = "@" .. LocalPlayer.Name
    pcall(function()
        Avatar.Image = Players:GetUserThumbnailAsync(LocalPlayer.UserId, Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size150x150)
    end)
end

local function spectatePlayer(p)
    if not p then
        unspectate()
        return
    end
    
    isSpectating = true
    DisplayNameLabel.Text = p.DisplayName
    UsernameLabel.Text = "@" .. p.Name
    
    pcall(function()
        Avatar.Image = Players:GetUserThumbnailAsync(p.UserId, Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size150x150)
    end)

    if p.Character then
        local hum = p.Character:FindFirstChildOfClass("Humanoid")
        if hum then
            Camera.CameraSubject = hum
        end
    end
end

local function changeSpectate(dir)
    local others = getOtherPlayers()
    if #others == 0 then
        unspectate()
        return
    end

    currentIndex = currentIndex + dir
    if currentIndex > #others then
        currentIndex = 1
    elseif currentIndex < 1 then
        currentIndex = #others
    end

    spectatePlayer(others[currentIndex])
end

PrevBtn.MouseButton1Click:Connect(function() changeSpectate(-1) end)
NextBtn.MouseButton1Click:Connect(function() changeSpectate(1) end)
ResetBtn.MouseButton1Click:Connect(unspectate)

CloseBtn.MouseButton1Click:Connect(function()
    unspectate()
    local tweenOut = TweenService:Create(MainFrame, TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
        Position = UDim2.new(0, -240, 0.5, -112)
    })
    tweenOut:Play()
    tweenOut.Completed:Connect(function()
        ScreenGui:Destroy()
    end)
end)

-- Непрерывный процесс (обновление камеры и статуса действия в реальном времени)
RunService.RenderStepped:Connect(function()
    local activePlayer = LocalPlayer
    
    if isSpectating then
        local others = getOtherPlayers()
        if others[currentIndex] then
            activePlayer = others[currentIndex]
            if activePlayer.Character then
                local hum = activePlayer.Character:FindFirstChildOfClass("Humanoid")
                if hum and Camera.CameraSubject ~= hum then
                    Camera.CameraSubject = hum
                end
            end
        end
    end

    -- Динамическое обновление действия
    ActionLabel.Text = "Статус: " .. getPlayerAction(activePlayer)
end)

