local function getMoveInput()
    local v = nil
    if Controls then
        pcall(function()
            local res = Controls:GetMoveVector()
            if typeof(res) == "Vector3" then v = res end
        end)
    end

    if not v then
        local x = (UserInputService:IsKeyDown(Enum.KeyCode.D) and 1 or 0) - (UserInputService:IsKeyDown(Enum.KeyCode.A) and 1 or 0)
        local z = (UserInputService:IsKeyDown(Enum.KeyCode.S) and 1 or 0) - (UserInputService:IsKeyDown(Enum.KeyCode.W) and 1 or 0)
        v = Vector3.new(x, 0, z)
    end

    if v.Magnitude > 1 then v = v.Unit end
    return v
end

local function computeMoveDirection(input, normal)
    if input.Magnitude < 0.05 then return Vector3.zero end

    local cam = Workspace.CurrentCamera
    if not cam then return Vector3.zero end

    local camCF = cam.CFrame
    local forward = projectOnPlane(camCF.LookVector, normal)
    if forward.Magnitude < 0.1 then
        forward = projectOnPlane(camCF.UpVector, normal)
    end
    if forward.Magnitude < 0.01 then return Vector3.zero end
    forward = forward.Unit

    local right = forward:Cross(normal)
    local dir = right * input.X + forward * (-input.Z)
    if dir.Magnitude > 1 then dir = dir.Unit end
    return dir
end

local function checkResetKeysPressed(inputKey)
    if #currentBindKeys == 0 then return false end
    if #currentBindKeys == 1 then
        return inputKey == currentBindKeys[1]
    elseif #currentBindKeys == 2 then
        local k1, k2 = currentBindKeys[1], currentBindKeys[2]
        if inputKey == k1 then
            return UserInputService:IsKeyDown(k2)
        elseif inputKey == k2 then
            return UserInputService:IsKeyDown(k1)
        end
    end
    return false
end

