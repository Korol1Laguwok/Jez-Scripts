local function getEquippedAnimId(animName, defaultId)
    local animScript = character and character:FindFirstChild("Animate")
    if animScript then
        local folder = animScript:FindFirstChild(animName)
        if folder then
            for _, child in ipairs(folder:GetChildren()) do
                if child:IsA("Animation") and child.AnimationId ~= "" then
                    return child.AnimationId
                end
            end
        end
    end
    return defaultId
end

local function loadAnimations()
    if walkTrack and idleTrack then return end

    animator = humanoid:FindFirstChildOfClass("Animator") or Instance.new("Animator", humanoid)

    local rigType = (humanoid.RigType == Enum.HumanoidRigType.R15) and "R15" or "R6"
    local data = CONFIG.ANIMS[rigType]

    local walkId = getEquippedAnimId("walk", data.WALK)
    local idleId = getEquippedAnimId("idle", data.IDLE)
    local jumpId = getEquippedAnimId("jump", data.JUMP)
    local fallId = getEquippedAnimId("fall", data.FALL)

    local function loadTrack(id, priority, looped)
        local ok, track = pcall(function()
            local anim = Instance.new("Animation")
            anim.AnimationId = id
            local t = animator:LoadAnimation(anim)
            t.Priority = priority
            t.Looped = looped
            return t
        end)
        return ok and track or nil
    end

    walkTrack = loadTrack(walkId, Enum.AnimationPriority.Action2, true)
    idleTrack = loadTrack(idleId, Enum.AnimationPriority.Action, true)
    jumpTrack = loadTrack(jumpId, Enum.AnimationPriority.Action3, false)
    fallTrack = loadTrack(fallId, Enum.AnimationPriority.Action3, true)
end

local function takeOverAnimations()
    animateScript = character:FindFirstChild("Animate")
    if animateScript and animateScript:IsA("LocalScript") then
        animateWasEnabled = animateScript.Enabled
        animateScript.Enabled = false
    else
        animateScript = nil
    end

    if animator then
        for _, track in ipairs(animator:GetPlayingAnimationTracks()) do
            if track ~= walkTrack and track ~= idleTrack and track ~= jumpTrack and track ~= fallTrack then
                track:Stop(0.1)
            end
        end
    end
end

local function releaseAnimations()
    if walkTrack then walkTrack:Stop(0.1) walkTrack = nil end
    if idleTrack then idleTrack:Stop(0.1) idleTrack = nil end
    if jumpTrack then jumpTrack:Stop(0.1) jumpTrack = nil end
    if fallTrack then fallTrack:Stop(0.1) fallTrack = nil end
    currentAnim = nil
    if animateScript and animateScript.Parent and animateWasEnabled then
        animateScript.Enabled = true
    end
    animateScript = nil
end

local function playAnim(name)
    if currentAnim == name then return end
    local tracks = { walk = walkTrack, idle = idleTrack, jump = jumpTrack, fall = fallTrack }
    for trackName, track in pairs(tracks) do
        if trackName ~= name and track and track.IsPlaying then
            track:Stop(0.1)
        end
    end
    local track = tracks[name]
    if track then track:Play(0.1) end
    currentAnim = name
end

