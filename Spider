local function drawProceduralWeb(parentFrame, centerX, centerY)
    local webContainer = Instance.new("Frame")
    webContainer.Name = "WebContainer"
    webContainer.Size = UDim2.new(1, 0, 1, 0)
    webContainer.BackgroundTransparency = 1
    webContainer.ClipsDescendants = true
    webContainer.ZIndex = 1
    webContainer.Parent = parentFrame

    local rays = 14
    local angleStep = 360 / rays
    local maxDist = 260
    local lineColor = Color3.fromRGB(80, 75, 75) -- Тёмно-серый тон как на образце

    -- Прямые лучи паутины
    for i = 1, rays do
        local deg = (i - 1) * angleStep
        local line = Instance.new("Frame")
        line.Size = UDim2.fromOffset(maxDist, 1.5)
        line.Position = UDim2.fromOffset(centerX, centerY)
        line.Rotation = deg
        line.AnchorPoint = Vector2.new(0, 0.5)
        line.BackgroundColor3 = lineColor
        line.BackgroundTransparency = 0.2
        line.BorderSizePixel = 0
        line.Parent = webContainer
    end

    local function drawLine(p1, p2, transp)
        local dx, dy = p2.X - p1.X, p2.Y - p1.Y
        local dist = math.sqrt(dx * dx + dy * dy)
        if dist < 0.5 then return end
        local angle = math.deg(math.atan2(dy, dx))

        local seg = Instance.new("Frame")
        seg.Size = UDim2.fromOffset(dist, 1.5)
        seg.Position = UDim2.fromOffset((p1.X + p2.X) / 2, (p1.Y + p2.Y) / 2)
        seg.AnchorPoint = Vector2.new(0.5, 0.5)
        seg.Rotation = angle
        seg.BackgroundColor3 = lineColor
        seg.BackgroundTransparency = transp or 0.25
        seg.BorderSizePixel = 0
        seg.ZIndex = 1
        seg.Parent = webContainer
    end

    -- Кольцевые дуги с закруглением внутрь к центру
    local radii = { 15, 30, 50, 75, 105, 140, 180, 225 }
    local centerVec = Vector2.new(centerX, centerY)

    for _, r in ipairs(radii) do
        for i = 1, rays do
            local a1 = math.rad((i - 1) * angleStep)
            local a2 = math.rad(i * angleStep)

            local p1 = centerVec + Vector2.new(math.cos(a1) * r, math.sin(a1) * r)
            local p2 = centerVec + Vector2.new(math.cos(a2) * r, math.sin(a2) * r)

            -- Создание вогнутой дуги (дуга вогнута к центру)
            local mid = (p1 + p2) / 2
            local sagAmount = 0.28
            local sagPoint = mid + (centerVec - mid) * sagAmount

            drawLine(p1, sagPoint, 0.25)
            drawLine(sagPoint, p2, 0.25)
        end
    end
end

