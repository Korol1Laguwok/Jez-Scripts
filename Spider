--------------------------------------------------------------------------------
local function onCharacterAdded(newChar)
    if active then
        active = false
        unbindCamera()
        unbindMouse()
    end
    cleanupPhysics()
    walkTrack, idleTrack, animator, animateScript = nil, nil, nil, nil
    grounded = false
    currentNormal = Vector3.yAxis
    targetNormal = Vector3.yAxis

    character = newChar
    humanoid = character:WaitForChild("Humanoid")
    hrp = character:WaitForChild("HumanoidRootPart")

    if diedConn then diedConn:Disconnect() end
    diedConn = humanoid.Died:Connect(function() disableSpider(false) end)

    updateUI()
end

_G.__SpiderWalkShutdown = shutdown

pcall(createUI)

table.insert(connections, LocalPlayer.CharacterAdded:Connect(onCharacterAdded))
if LocalPlayer.Character then task.spawn(onCharacterAdded, LocalPlayer.Character) end

table.insert(connections, UserInputService.JumpRequest:Connect(tryJump))

table.insert(connections, UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    if input.KeyCode == CONFIG.TOGGLE_KEY then
        if active then disableSpider(true) else enableSpider() end
    elseif checkResetKeysPressed(input.KeyCode) then
        resetCursorOnly()
    end
end))

table.insert(connections, RunService.Heartbeat:Connect(function(dt)
    if destroyed then return end
    pcall(onHeartbeat, dt)
    statusTimer += dt
    if statusTimer > 0.2 then
        statusTimer = 0
        updateUI()
    end
end))
