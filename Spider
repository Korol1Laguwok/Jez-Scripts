local function computeHover()
    if humanoid.RigType == Enum.HumanoidRigType.R15 then
        return humanoid.HipHeight + hrp.Size.Y / 2 + CONFIG.HOVER_EXTRA
    end
    return hrp.Size.Y / 2 + 2 + CONFIG.HOVER_EXTRA
end

local function getWalkSpeed()
    local ws = CONFIG.WALK_SPEED
    if humanoid and humanoid.WalkSpeed > 0 then ws = humanoid.WalkSpeed end
    return ws * speedMultiplier
end

local function getJumpPower()
    local power = CONFIG.JUMP_POWER
    if humanoid then
        if humanoid.UseJumpPower then
            power = humanoid.JumpPower
        else
            power = math.sqrt(2 * Workspace.Gravity * humanoid.JumpHeight)
        end
    end
    if power < 10 then power = CONFIG.JUMP_POWER end
    return power * jumpMultiplier
end

