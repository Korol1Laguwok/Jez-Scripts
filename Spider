function enableSpider()
    if active then return end
    if not character or not humanoid or not hrp or humanoid.Health <= 0 then return end

    lastError = ""
    refreshFilter()
    raycastParams.CollisionGroup = hrp.CollisionGroup
    hover = computeHover()

    currentNormal = Vector3.yAxis
    targetNormal = Vector3.yAxis
    planeVel = Vector3.zero
    grounded = false
    airTime = 0
    airBlockUntil = 0
    filterTimer = 0
    camUp = Vector3.yAxis
    lastCamRot = CFrame.new()

    setupPhysics()
    loadAnimations()
    takeOverAnimations()

    humanoid.PlatformStand = true
    humanoid.AutoRotate = false

    active = true
    bindCamera()
    bindMouse()
    updateUI()
end

function disableSpider(upright)
    if not active then return end
    active = false

    unbindCamera()
    unbindMouse()
    cleanupPhysics()
    releaseAnimations()

    if humanoid and humanoid.Parent then
        humanoid.PlatformStand = false
        humanoid.AutoRotate = true
    end

    if upright and hrp and hrp.Parent and humanoid and humanoid.Health > 0 then
        if currentNormal.Y < 0.7 then
            local look = hrp.CFrame.LookVector
            local flat = Vector3.new(look.X, 0, look.Z)
            if flat.Magnitude < 0.1 then
                local cam = Workspace.CurrentCamera
                if cam then
                    local cl = cam.CFrame.LookVector
                    flat = Vector3.new(cl.X, 0, cl.Z)
                end
            end
            if flat.Magnitude < 0.01 then flat = Vector3.new(0, 0, -1) end
            hrp.AssemblyAngularVelocity = Vector3.zero
            hrp.CFrame = CFrame.lookAt(hrp.Position, hrp.Position + flat.Unit)
            humanoid:ChangeState(Enum.HumanoidStateType.Freefall)
        else
            humanoid:ChangeState(Enum.HumanoidStateType.Running)
        end
    end

    currentNormal = Vector3.yAxis
    targetNormal = Vector3.yAxis
    grounded = false
    updateUI()
end

shutdown = function()
    if destroyed then return end
    destroyed = true

    pcall(disableSpider, true)

    pcall(unbindCamera)
    pcall(unbindMouse)

    UserInputService.MouseBehavior = Enum.MouseBehavior.Default
    UserInputService.MouseIconEnabled = true

    for _, c in ipairs(connections) do 
        pcall(function() c:Disconnect() end) 
    end
    table.clear(connections)

    if diedConn then 
        pcall(function() diedConn:Disconnect() end) 
        diedConn = nil 
    end

    if screenGui then
        screenGui:Destroy()
        screenGui = nil
    end

    if _G.__SpiderWalkShutdown == shutdown then
        _G.__SpiderWalkShutdown = nil
    end

    pcall(function()
        script:Destroy()
    end)
end

