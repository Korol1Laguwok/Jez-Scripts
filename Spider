local function checkMicroFootSurfaces(pos, normal, dist)
    local centerHit = cast(pos, -normal * dist)
    if centerHit then return centerHit end

    local cf = hrp.CFrame
    local r = cf.RightVector * 0.7
    local f = cf.LookVector * 0.7

    local offsets = { r, -r, f, -f, r + f, r - f, -r + f, -r - f }
    for _, offset in ipairs(offsets) do
        local hit = cast(pos + offset, -normal * dist)
        if hit then return hit end
    end

    return nil
end

