local function startBindingReset()
    if isBindingReset then return end
    isBindingReset = true
    resetKeybindBtn.Text = "[ Нажмите... ]"
    resetKeybindBtn.BackgroundColor3 = Color3.fromRGB(150, 150, 150)
    resetKeybindBtn.TextColor3 = Color3.fromRGB(0, 0, 0)

    local capturedKeys = {}
    local connBegan, connEnded

    connBegan = UserInputService.InputBegan:Connect(function(input, gpe)
        if input.UserInputType ~= Enum.UserInputType.Keyboard then return end
        if input.KeyCode == Enum.KeyCode.Unknown then return end

        local exists = false
        for _, k in ipairs(capturedKeys) do
            if k == input.KeyCode then exists = true break end
        end
        if not exists then
            table.insert(capturedKeys, input.KeyCode)
        end

        if #capturedKeys >= 2 then
            currentBindKeys = { capturedKeys[1], capturedKeys[2] }
            isBindingReset = false
            resetKeybindBtn.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
            resetKeybindBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
            resetKeybindBtn.Text = keyNamesToString(currentBindKeys)
            if connBegan then connBegan:Disconnect() end
            if connEnded then connEnded:Disconnect() end
            saveConfig()
        end
    end)

    connEnded = UserInputService.InputEnded:Connect(function(input, gpe)
        if not isBindingReset then return end
        if input.UserInputType == Enum.UserInputType.Keyboard and #capturedKeys == 1 then
            task.delay(0.12, function()
                if isBindingReset and #capturedKeys == 1 then
                    currentBindKeys = { capturedKeys[1] }
                    isBindingReset = false
                    resetKeybindBtn.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
                    resetKeybindBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
                    resetKeybindBtn.Text = keyNamesToString(currentBindKeys)
                    if connBegan then connBegan:Disconnect() end
                    if connEnded then connEnded:Disconnect() end
                    saveConfig()
                end
            end)
        end
    end)
end

