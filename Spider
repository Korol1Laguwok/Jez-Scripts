local WRAP_DEPTHS = { 0.2, 0.8, 1.8, 3.5, 5.0 }

local function castForward(pos, dir)
    local hit = cast(pos, dir * CONFIG.RAY_FORWARD_DIST)
    if hit then return hit end
    return cast(pos - currentNormal * math.max(hover - 0.4, 0.3), dir * CONFIG.RAY_FORWARD_DIST)
end

local function onHeartbeat(dt)
    if not active then return end
    if not (character and character.Parent and humanoid and hrp and hrp.Parent) or humanoid.Health <= 0 then return end
    if not (linearVelocity and vectorForce and alignOrientation) then return end

    local now = os.clock()

    filterTimer += dt
    if filterTimer > 0.5 then
        filterTimer = 0
        refreshFilter()
    end

    humanoid.PlatformStand = true

    currentNormal = slerpVector(currentNormal, targetNormal, 1 - math.exp(-dt * CONFIG.NORMAL_SMOOTH_SPEED))

    local input = getMoveInput()
    lastInput = input
    local moveDir = computeMoveDirection(input, currentNormal)
    local moving = moveDir.Magnitude > 0.05

    if humanoid.Jump then
        humanoid.Jump = false
        tryJump()
    end

    local pos = hrp.Position
    local rayDownDist = hover + CONFIG.RAY_DOWN_EXTRA

    local downHit = checkMicroFootSurfaces(pos, currentNormal, rayDownDist)

    if now >= airBlockUntil then
        local newNormal = nil
        local fwdHit = nil

        if moving then
            fwdHit = castForward(pos, moveDir.Unit)
        else
            fwdHit = cast(pos, hrp.CFrame.LookVector * CONFIG.RAY_FORWARD_DIST)
        end

        local predictDown = moving and checkMicroFootSurfaces(pos + moveDir.Unit * 1.5, currentNormal, rayDownDist) or nil

        if fwdHit then
            newNormal = fwdHit.Normal
        elseif downHit then
            newNormal = downHit.Normal
        elseif predictDown then
            newNormal = predictDown.Normal
        elseif moving then
            local dir = moveDir.Unit
            for _, depth in ipairs(WRAP_DEPTHS) do
                local origin = pos + dir * CONFIG.RAY_WRAP_AHEAD - currentNormal * (hover + depth)
                local wrapHit = cast(origin, -dir * CONFIG.RAY_WRAP_LENGTH)
                if wrapHit then
                    newNormal = wrapHit.Normal
                    break
                end
            end
        end

        if not newNormal and grounded then
            local searchDirs = {
                -currentNormal,
                hrp.CFrame.LookVector,
                -hrp.CFrame.LookVector,
                hrp.CFrame.RightVector,
                -hrp.CFrame.RightVector
            }
            for _, d in ipairs(searchDirs) do
                local edgeHit = cast(pos, d * 4.5)
                if edgeHit then
                    newNormal = edgeHit.Normal
                    break
                end
            end

            if not newNormal and (now - lastSurfaceTime < CONFIG.COYOTE_TIME or not moving) then
                newNormal = targetNormal
            end
        end

        if not newNormal and not grounded then
            local vel = hrp.AssemblyLinearVelocity
            if vel.Magnitude > 5 then
                local velHit = cast(pos, vel.Unit * CONFIG.RAY_VELOCITY_DIST)
                if velHit then
                    newNormal = velHit.Normal
                end
            end
        end

        if newNormal then
            targetNormal = slerpVector(targetNormal, newNormal, 1 - math.exp(-dt * 20))
            grounded = true
            lastSurfaceTime = now
        else
            grounded = false
        end
    elseif now < airBlockUntil then
        grounded = false
    end

    if grounded then
        airTime = 0
        noSurfaceTime = 0
        airBlend = 0
    else
        airTime += dt
        local pullHit = cast(pos, -currentNormal * CONFIG.AIR_SURFACE_CHECK)
        if pullHit and airTime < CONFIG.AIR_MAX_SURFACE_TIME then
            noSurfaceTime = math.max(noSurfaceTime - dt * 4, 0)
        else
            noSurfaceTime += dt
        end
        airBlend = math.clamp(noSurfaceTime / CONFIG.AIR_BLEND_TIME, 0, 1)
        if airBlend >= 1 then
            targetNormal = Vector3.yAxis
        end
    end

    local mass = hrp.AssemblyMass
    local g = Workspace.Gravity
    local planarMove = projectOnPlane(moveDir, currentNormal)

    if grounded then
        local normalVel = Vector3.zero
        if downHit then
            local err = hover - downHit.Distance
            local targetSpeed = math.clamp(err * CONFIG.HOVER_STIFFNESS, -CONFIG.HOVER_MAX_SPEED, CONFIG.HOVER_MAX_SPEED)
            normalVel = currentNormal * targetSpeed
        else
            normalVel = -currentNormal * CONFIG.SNAP_SPEED
        end

        local target = planarMove * getWalkSpeed()
        local currentPlaneVel = projectOnPlane(planeVel, currentNormal)
        local rate = (target.Magnitude < currentPlaneVel.Magnitude) and CONFIG.DECELERATION or CONFIG.ACCELERATION
        planeVel = currentPlaneVel:Lerp(target, 1 - math.exp(-dt * rate))

        linearVelocity.Enabled = true
        linearVelocity.VectorVelocity = planeVel + normalVel
    else
        linearVelocity.Enabled = false
        planeVel = projectOnPlane(hrp.AssemblyLinearVelocity, currentNormal)
    end

    local gravityDir = -currentNormal
    if not grounded and airBlend > 0 then
        gravityDir = gravityDir * (1 - airBlend) + Vector3.new(0, -1, 0) * airBlend
    end
    local force = (Vector3.yAxis + gravityDir) * (g * mass)
    if not grounded and moving then
        force += planarMove * (CONFIG.AIR_ACCEL * mass)
    end
    vectorForce.Force = force

    if not grounded then
        local vel = hrp.AssemblyLinearVelocity
        if vel.Magnitude > CONFIG.MAX_AIR_SPEED then
            hrp.AssemblyLinearVelocity = vel.Unit * CONFIG.MAX_AIR_SPEED
        end
    end

    local cam = Workspace.CurrentCamera
    local isLockedMouse = (UserInputService.MouseBehavior == Enum.MouseBehavior.LockCenter)
        or (cam and (cam.CFrame.Position - cam.Focus.Position).Magnitude < 1.2)

    local facing
    if moving then
        facing = planarMove
    elseif isLockedMouse and cam then
        facing = projectOnPlane(cam.CFrame.LookVector, currentNormal)
    else
        facing = projectOnPlane(hrp.CFrame.LookVector, currentNormal)
    end

    if facing.Magnitude < 0.05 then
        facing = perpendicular(currentNormal)
    else
        facing = facing.Unit
    end
    alignOrientation.CFrame = CFrame.lookAt(pos, pos + facing, currentNormal)

    if grounded then
        if moving then
            playAnim("walk")
            if walkTrack then
                walkTrack:AdjustSpeed(math.clamp(planeVel.Magnitude / 16, 0.5, 1.6))
            end
        else
            playAnim("idle")
        end
    else
        if now - lastJumpTime < CONFIG.JUMP_ANIM_TIME then
            playAnim("jump")
        else
            playAnim("fall")
        end
    end
end

