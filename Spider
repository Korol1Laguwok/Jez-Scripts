local function tryJump()
    if not active or not grounded or not hrp or not linearVelocity then return end

    local now = os.clock()
    if now - lastJumpTime < CONFIG.JUMP_COOLDOWN then return end
    lastJumpTime = now
    airBlockUntil = now + CONFIG.JUMP_AIR_BLOCK

    grounded = false
    noSurfaceTime = 0
    airBlend = 0
    lastSurfaceTime = -1000
    linearVelocity.Enabled = false
    
    hrp.AssemblyLinearVelocity = planeVel + currentNormal * getJumpPower()
end

