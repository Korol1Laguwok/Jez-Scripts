-- 3. МАТЕМАТИКА И ВСПОМОГАТЕЛЬНЫЕ ФУНКЦИИ
--------------------------------------------------------------------------------
local function projectOnPlane(v, n)
    return v - n * v:Dot(n)
end

local function perpendicular(v)
    local p = v:Cross(Vector3.xAxis)
    if p.Magnitude < 1e-3 then
        p = v:Cross(Vector3.zAxis)
    end
    return p.Unit
end

local function rotationBetween(a, b)
    local dot = math.clamp(a:Dot(b), -1, 1)
    if dot > 0.99999 then
        return CFrame.new()
    end
    local axis = a:Cross(b)
    if axis.Magnitude < 1e-5 then
        return CFrame.fromAxisAngle(perpendicular(a), math.pi)
    end
    return CFrame.fromAxisAngle(axis.Unit, math.acos(dot))
end

local function slerpVector(a, b, t)
    local dot = math.clamp(a:Dot(b), -1, 1)
    local angle = math.acos(dot)
    if angle < 1e-3 then
        return b
    end
    local axis = a:Cross(b)
    if axis.Magnitude < 1e-4 then
        axis = perpendicular(a)
    else
        axis = axis.Unit
    end
    return (CFrame.fromAxisAngle(axis, angle * t) * a).Unit
end

local function cast(origin, direction)
    return Workspace:Raycast(origin, direction, raycastParams)
end

local function refreshFilter()
    local list = {}
    for _, p in ipairs(Players:GetPlayers()) do
        if p.Character then
            table.insert(list, p.Character)
        end
    end
    raycastParams.FilterDescendantsInstances = list
end

local function keyNamesToString(keys)
    if #keys == 0 then return "[ Нет ]" end
    local names = {}
    for _, k in ipairs(keys) do
        local name = k.Name
        if name == "LeftControl" or name == "RightControl" then name = "Ctrl"
        elseif name == "LeftShift" or name == "RightShift" then name = "Shift"
        elseif name == "LeftAlt" or name == "RightAlt" then name = "Alt" end
        table.insert(names, name)
    end
    return "[ " .. table.concat(names, "+") .. " ]"
end

