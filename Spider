local function cameraPre()
    local cam = Workspace.CurrentCamera
    if not cam then return end
    local cf = cam.CFrame
    cam.CFrame = CFrame.new(cf.Position) * (lastCamRot:Inverse() * (cf - cf.Position))
end

local function getDesiredZoom()
    local cm = CameraModuleRef
    if not cm then return nil end
    local ctrl = cm.activeCameraController
    if not ctrl then return nil end
    local ok, d = pcall(function() return ctrl:GetCameraToSubjectDistance() end)
    if ok and type(d) == "number" then return d end
    return nil
end

local function cameraPost(dt)
    local cam = Workspace.CurrentCamera
    if not cam or not hrp or not hrp.Parent then return end

    local targetUp = currentNormal
    local stepUp = slerpVector(camUp, targetUp, 1 - math.exp(-dt * CONFIG.CAMERA_SMOOTH_SPEED))

    local deltaRot = rotationBetween(camUp, stepUp)
    camUp = stepUp
    lastCamRot = deltaRot * lastCamRot

    local cf = cam.CFrame
    local head = character:FindFirstChild("Head") or hrp
    local focus = head.Position + camUp * 0.6

    local rel = cf.Position - focus
    local dist = rel.Magnitude
    local dir = (dist > 1e-3) and rel.Unit or -cf.LookVector

    local desired = getDesiredZoom()
    if desired and desired > dist then dist = desired end

    local rdir = lastCamRot * dir
    if dist > 1.2 then
        local camRayParams = RaycastParams.new()
        camRayParams.FilterType = Enum.RaycastFilterType.Exclude
        camRayParams.FilterDescendantsInstances = {character}
        camRayParams.IgnoreWater = true

        local hit = Workspace:Raycast(focus, rdir * dist, camRayParams)
        if hit then
            dist = math.max(hit.Distance - 0.4, 2.0)
        end
    end

    cam.CFrame = CFrame.new(focus + rdir * dist) * lastCamRot * (cf - cf.Position)
end

local function safeCameraPre() pcall(cameraPre) end
local function safeCameraPost(dt) pcall(cameraPost, dt) end

local function bindCamera()
    RunService:UnbindFromRenderStep("SpiderCameraPre")
    RunService:UnbindFromRenderStep("SpiderCameraPost")
    RunService:BindToRenderStep("SpiderCameraPre", Enum.RenderPriority.Camera.Value - 1, safeCameraPre)
    RunService:BindToRenderStep("SpiderCameraPost", Enum.RenderPriority.Camera.Value + 1, safeCameraPost)
end

local function unbindCamera()
    RunService:UnbindFromRenderStep("SpiderCameraPre")
    RunService:UnbindFromRenderStep("SpiderCameraPost")

    local cam = Workspace.CurrentCamera
    if cam then
        if (camUp - Vector3.yAxis).Magnitude > 0.08 then
            local cf = cam.CFrame
            cam.CFrame = CFrame.new(cf.Position) * (lastCamRot:Inverse() * (cf - cf.Position))
        end
    end
    lastCamRot = CFrame.new()
    camUp = Vector3.yAxis
end

