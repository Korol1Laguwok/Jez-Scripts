    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 6)
    return btn
end

-- ФУНКЦИЯ ПОИСКА ИГРОКА
function GetPlayer(str)
    for _, a in pairs(Players:GetPlayers()) do
        if string.match(string.lower(a.Name), string.lower(str)) then
            return a
        end
    end
    return nil
end

