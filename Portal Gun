    Color3.fromRGB(200, 204, 213),
    Color3.fromRGB(225, 228, 236),
}

local function getPortalBackgroundColor(t)
    local count = #PORTAL_COLOR_PALETTE
    local position = (t % count)
    local index1 = math.floor(position) + 1
    local index2 = (index1 % count) + 1
    local fraction = position - math.floor(position)
    local smoothFraction = (1 - math.cos(fraction * math.pi)) / 2
    return PORTAL_COLOR_PALETTE[index1]:Lerp(PORTAL_COLOR_PALETTE[index2], smoothFraction)
end

-- ВЫЧИСЛЕНИЕ МАСШТАБА ПУШКИ В ЗАВИСИМОСТИ ОТ RIG TYPE (R6 / R15)
local function getGunScaleForCharacter()
    local character = player.Character or player.CharacterAdded:Wait()
    local humanoid = character:WaitForChild("Humanoid", 5)
    
    if humanoid and humanoid.RigType == Enum.HumanoidRigType.R6 then
        return 0.40
    else
        return 0.58
    end
end

