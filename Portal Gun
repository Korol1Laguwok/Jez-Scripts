local function spawnSinglePortalVisuals(model, name, cframe, liftMultiplier)
    local targetSize = Vector3.new(9.2, 9.1, 0.4)
    local openDuration = 0.85

    if liftMultiplier == nil then liftMultiplier = 0.18 end
    local elevatedCFrame = cframe * CFrame.new(0, targetSize.Y * liftMultiplier, 0)

    local portal = Instance.new("Part")
    portal.Name = name
    portal.Size = Vector3.new(0.01, 0.01, 0.01)
    portal.CFrame = elevatedCFrame
    portal.Color = PORTAL_BG_COLOR
    portal.Material = Enum.Material.SmoothPlastic
    portal.Transparency = 0
    portal.Anchored = true
    portal.CanCollide = false
    portal.CanTouch = true
    portal.CanQuery = false
    portal.Parent = model

    local portalMesh = Instance.new("SpecialMesh")
    portalMesh.MeshType = Enum.MeshType.Sphere
    portalMesh.Scale = Vector3.new(0.68, 1, 0.12)
    portalMesh.Parent = portal

    local spiralLineSegments = {}
    local NUM_SPIRAL_ARMS = 5
    local SEGMENTS_PER_ARM = 8

    local spiralShades = {
        Color3.fromRGB(255, 255, 255),
        Color3.fromRGB(220, 225, 230),
        Color3.fromRGB(180, 185, 195),
        Color3.fromRGB(140, 145, 155),
        Color3.fromRGB(200, 205, 215)
    }

    for side = -1, 1, 2 do
        for arm = 1, NUM_SPIRAL_ARMS do
            local armColor = spiralShades[arm] or spiralShades[1]
            for seg = 1, SEGMENTS_PER_ARM do
                local linePart = Instance.new("Part")
                linePart.Name = string.format("%s_Spiral_Arm%d_Seg%d_Side%d", name, arm, seg, side)
                linePart.Shape = Enum.PartType.Block
                linePart.Size = Vector3.new(0.42, 0.09, 0.06)
                linePart.Color = armColor
                linePart.Material = Enum.Material.SmoothPlastic
                linePart.Transparency = 0
                linePart.Anchored = true
                linePart.CanCollide = false
                linePart.CanTouch = false
                linePart.CanQuery = false
                linePart.Parent = model

                table.insert(spiralLineSegments, {
                    part = linePart,
                    arm = arm,
                    seg = seg,
                    total = SEGMENTS_PER_ARM,
                    side = side
                })
            end
        end
    end

    local movingDots = {}
    local NUM_DOTS = 10
    local dotShades = {
        Color3.fromRGB(240, 240, 245),
        Color3.fromRGB(170, 175, 185),
        Color3.fromRGB(120, 125, 135)
    }

    for i = 1, NUM_DOTS do
        local dot = Instance.new("Part")
        dot.Name = string.format("%s_Dot_%d", name, i)
        dot.Shape = Enum.PartType.Ball

        local dotDiameter = 0.10 + (i % 3) * 0.03
        dot.Size = Vector3.new(dotDiameter, dotDiameter, dotDiameter)
        dot.Color = dotShades[(i % #dotShades) + 1]
        dot.Material = Enum.Material.SmoothPlastic
        dot.Transparency = 0
        dot.Anchored = true
        dot.CanCollide = false
        dot.CanTouch = false
        dot.CanQuery = false
        dot.Parent = model

        local isFront = (i % 2 == 0)
        table.insert(movingDots, {
            part = dot,
            seed = i * 1.5,
            speed = 0.7 + (i % 4) * 0.3,
            minRadiusX = 0.45 * (targetSize.X * 0.42),
            maxRadiusX = 0.88 * (targetSize.X * 0.42),
            minRadiusY = 0.45 * (targetSize.Y * 0.42),
            maxRadiusY = 0.88 * (targetSize.Y * 0.42),
            zOffset = isFront and -0.14 or 0.14
        })
    end

    local light = Instance.new("PointLight")
    light.Color = WHITE_ACCENT
    light.Brightness = 0
    light.Range = 10
    light.Parent = portal

    TweenService:Create(portal, TweenInfo.new(openDuration, Enum.EasingStyle.Elastic, Enum.EasingDirection.Out, 0, false, 0.1), {Size = targetSize}):Play()
    TweenService:Create(light, TweenInfo.new(openDuration, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Brightness = 1.0}):Play()

    return {
        portal = portal,
        light = light,
        spiralLineSegments = spiralLineSegments,
        movingDots = movingDots,
        targetSize = targetSize,
        baseCFrame = elevatedCFrame,
        colorSeed = math.random() * #PORTAL_COLOR_PALETTE
    }
end

