local function updateTeleportMode(mode)
    teleportMode = mode

    local isCoord   = (mode == "Coordinates")
    local isPlaceId = (mode == "PlaceId")
    local isPlayers = (mode == "Players")

    xBox.Visible                = isCoord
    yBox.Visible                = isCoord
    zBox.Visible                = isCoord
    placeIdBox.Visible          = isPlaceId
    placeIdDropdownBtn.Visible  = isPlaceId
    playersScroll.Visible       = isPlayers

    if not isPlaceId then
        popularPlacesScroll.Visible = false
    end

    local function setBtnActive(btn, active)
        btn.BackgroundColor3 = active and WHITE_ACCENT or Color3.fromRGB(28, 32, 38)
        btn.TextColor3       = active and Color3.fromRGB(15, 18, 22) or Color3.fromRGB(160, 175, 190)
    end

    setBtnActive(coordinatesModeButton, isCoord)
    setBtnActive(placeIdModeButton,     isPlaceId)
    setBtnActive(playersModeButton,     isPlayers)

    if isCoord then
        subtitle.Text = "Введите координаты назначения"
        createButton.Text = "ОТКРЫТЬ ПОРТАЛЫ"
        status.Text = "Введите X, Y и Z"
    elseif isPlaceId then
        subtitle.Text = "Введите Place ID или выберите из списка 🔽"
        createButton.Text = "ОТКРЫТЬ ПОРТАЛ"
        status.Text = "Введите Place ID"
    elseif isPlayers then
        subtitle.Text = "Выберите игрока из списка"
        createButton.Text = "ОТКРЫТЬ ПОРТАЛ К ИГРОКУ"
        status.Text = selectedPlayer and ("Выбран: " .. selectedPlayer.DisplayName) or "Выберите игрока"
        updatePlayerList()
    end
    status.TextColor3 = Color3.fromRGB(140, 155, 170)
end

