local function fireLiquidShot(startPos, targetCFrame, onImpactCallback)
    local shot = Instance.new("Part")
    shot.Name = "LiquidShot"
    shot.Shape = Enum.PartType.Ball
    shot.Size = Vector3.new(0.5, 0.5, 0.5)
    shot.Color = WHITE_ACCENT
    shot.Material = Enum.Material.Neon
    shot.Transparency = 0.05
    shot.CFrame = CFrame.lookAt(startPos, targetCFrame.Position)
    shot.CanCollide = false
    shot.CanTouch = false
    shot.CanQuery = false
    shot.Massless = true
    shot.Anchored = true
    shot.Parent = workspace

    local attach = Instance.new("Attachment")
    attach.Parent = shot

    local particles = Instance.new("ParticleEmitter")
    particles.Color = ColorSequence.new(WHITE_ACCENT)
    particles.LightEmission = 1
    particles.LightInfluence = 0
    particles.Rate = 180
    particles.Lifetime = NumberRange.new(0.2, 0.45)
    particles.Speed = NumberRange.new(2, 6)
    particles.SpreadAngle = Vector2.new(180, 180)
    particles.Size = NumberSequence.new({
        NumberSequenceKeypoint.new(0, 1.2),
        NumberSequenceKeypoint.new(1, 0)
    })
    particles.Parent = attach

    local flyTween = TweenService:Create(shot, TweenInfo.new(0.4, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
        CFrame = targetCFrame,
        Size = Vector3.new(4.5, 6.2, 0.4)
    })
    flyTween:Play()

    flyTween.Completed:Connect(function()
        particles.Enabled = false

        local expandTween = TweenService:Create(shot, TweenInfo.new(0.25, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
            Size = Vector3.new(6.8, 8.2, 0.35),
            Transparency = 1
        })
        expandTween:Play()

        onImpactCallback()

        task.delay(0.3, function()
            shot:Destroy()
        end)
    end)
end

