local function createMarker(transparency)
    local m = Instance.new("Part")
    m.Name = "PortalPickMarker"
    m.Shape = Enum.PartType.Ball
    m.Size = Vector3.new(1, 1, 1)
    m.Color = WHITE_ACCENT
    m.Material = Enum.Material.Neon
    m.Transparency = transparency
    m.Anchored = true
    m.CanCollide = false
    m.CanTouch = false
    m.CanQuery = false
    m.Parent = workspace
    return m
end

local function getMarkerSize(position)
    local cam = workspace.CurrentCamera
    if not cam then return Vector3.one end
    local dist = (position - cam.CFrame.Position).Magnitude
    return Vector3.one * math.clamp(dist / 80, 1, 60)
end

local function raycastFromMouse()
    local camera = workspace.CurrentCamera
    if not camera then return nil end
    local loc = UserInputService:GetMouseLocation()
    local ray = camera:ViewportPointToRay(loc.X, loc.Y)
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    local ignore = {}
    if player.Character then table.insert(ignore, player.Character) end
    if currentPortalModel then table.insert(ignore, currentPortalModel) end
    params.FilterDescendantsInstances = ignore

    local result = workspace:Raycast(ray.Origin, ray.Direction * PICK_MAX_DISTANCE, params)
    if result then return result end

    local flatBack = Vector3.new(-ray.Direction.X, 0, -ray.Direction.Z)
    if flatBack.Magnitude < 0.01 then flatBack = Vector3.new(0, 0, 1) end
    return {
        Position = ray.Origin + ray.Direction * PICK_AIR_DISTANCE,
        Normal = flatBack.Unit,
        Instance = nil,
    }
end

local function buildPortalCFrame(result)
    local n = result.Normal
    local pos = result.Position
    local camera = workspace.CurrentCamera

    if math.abs(n.Y) > 0.7 then
        local look = camera.CFrame.LookVector
        local flat = Vector3.new(look.X, 0, look.Z)
        if flat.Magnitude < 0.01 then flat = Vector3.new(0, 0, -1) end
        local facing = -flat.Unit
        local yShift = n.Y > 0 and PORTAL_HALF_HEIGHT or -PORTAL_HALF_HEIGHT
        local center = pos + Vector3.new(0, yShift, 0)
        return CFrame.lookAt(center, center + facing)
    else
        local flatN = Vector3.new(n.X, 0, n.Z).Unit
        local center = pos + flatN * 0.3
        return CFrame.lookAt(center, center + flatN)
    end
end

function pick.cancel()
    pick.state = nil
    pick.firstCFrame = nil
    if pick.conn then pick.conn:Disconnect() pick.conn = nil end
    if pick.marker then pick.marker:Destroy() pick.marker = nil end
    if pick.ghost then pick.ghost:Destroy() pick.ghost = nil end
    if pick.hint then pick.hint.Visible = false end
end

function pick.start()
    if not isGunEquipped then return end
    if pick.state then
        pick.cancel()
        return
    end

    main.Visible = false
    pick.state = 1
    pick.firstCFrame = nil

    pick.hint = pick.hint or createPickHint()
    pick.hint.Text = "🎯 Кликни, куда поставить ПЕРВЫЙ портал (X — отмена)"
    pick.hint.Visible = true

    pick.marker = createMarker(0.3)
    pick.conn = RunService.RenderStepped:Connect(function()
        local result = raycastFromMouse()
        if result and pick.marker then
            pick.marker.Size = getMarkerSize(result.Position)
            pick.marker.Position = result.Position + result.Normal * 0.5
        end
    end)
end

function pick.click()
    local result = raycastFromMouse()
    if not result then return end
    local cf = buildPortalCFrame(result)

    if pick.state == 1 then
        pick.firstCFrame = cf
        pick.ghost = createMarker(0.6)
        pick.ghost.Size = getMarkerSize(result.Position)
        pick.ghost.Position = result.Position + result.Normal * 0.5
        pick.state = 2
        pick.hint.Text = "🎯 Теперь кликни, куда поставить ВТОРОЙ портал"
    elseif pick.state == 2 then
        local first = pick.firstCFrame
        local lifetime = tonumber(timeBox.Text) or DEFAULT_PORTAL_LIFETIME
        if lifetime <= 0 then lifetime = DEFAULT_PORTAL_LIFETIME end

        pick.cancel()

        portalRequestId = portalRequestId + 1
        removePortal()
        spawnPortalModel(first, nil, nil, lifetime, 0, cf)

        status.Text = string.format("Свои порталы открыты (%d сек)", lifetime)
        status.TextColor3 = WHITE_ACCENT
    end
end

