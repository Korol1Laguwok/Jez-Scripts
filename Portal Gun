local function spawnPortalModel(entranceCFrame, targetPosition, targetPlaceId, portalLifetime, entranceLiftMultiplier, exitCFrameOverride)
    local model = Instance.new("Model")
    model.Name = "RickMortyPortalPair"
    model.Parent = workspace
    currentPortalModel = model

    local activePortals = {}

    local entranceData = spawnSinglePortalVisuals(model, "EntrancePortal", entranceCFrame, entranceLiftMultiplier)
    table.insert(activePortals, entranceData)

    local exitData = nil
    if exitCFrameOverride then
        exitData = spawnSinglePortalVisuals(model, "ExitPortal", exitCFrameOverride, 0)
        table.insert(activePortals, exitData)
    elseif targetPosition then
        local exitCFrame = CFrame.new(targetPosition) * CFrame.Angles(0, math.rad(180), 0)
        exitData = spawnSinglePortalVisuals(model, "ExitPortal", exitCFrame)
        table.insert(activePortals, exitData)
    end

    local startTime = os.clock()
    portalAnimationConnection = RunService.RenderStepped:Connect(function()
        if not model.Parent then
            if portalAnimationConnection then
                portalAnimationConnection:Disconnect()
                portalAnimationConnection = nil
            end
            return
        end

        local elapsed = os.clock() - startTime

        for _, data in ipairs(activePortals) do
            local jellyPulse = math.sin(elapsed * 6) * 0.015
            local pulseScaleX = 1 + jellyPulse
            local pulseScaleY = 1 - jellyPulse * 0.5

            data.portal.Size = Vector3.new(data.targetSize.X * pulseScaleX, data.targetSize.Y * pulseScaleY, data.targetSize.Z)
            data.portal.Color = getPortalBackgroundColor(elapsed * 0.9 + data.colorSeed)

            local spiralSpeed = elapsed * 3.2
            local armOffsetStep = (math.pi * 2) / 5

            local rxMax = data.targetSize.X * 0.40 * pulseScaleX
            local ryMax = data.targetSize.Y * 0.40 * pulseScaleY

            for _, segData in ipairs(data.spiralLineSegments) do
                local armOffset = (segData.arm - 1) * armOffsetStep

                local t1 = (segData.seg - 1) / segData.total
                local t2 = segData.seg / segData.total

                local angle1 = spiralSpeed + armOffset + (t1 * math.pi * 2.5)
                local angle2 = spiralSpeed + armOffset + (t2 * math.pi * 2.5)

                local p1 = Vector2.new(math.cos(angle1) * t1 * rxMax, math.sin(angle1) * t1 * ryMax)
                local p2 = Vector2.new(math.cos(angle2) * t2 * rxMax, math.sin(angle2) * t2 * ryMax)

                local midP = (p1 + p2) / 2
                local dir = (p2 - p1)
                local lineLength = dir.Magnitude
                local lineAngle = math.atan2(dir.Y, dir.X)

                segData.part.Size = Vector3.new(lineLength * 1.05, 0.09, 0.06)
                local zPos = segData.side * 0.12
                segData.part.CFrame = data.portal.CFrame * CFrame.new(midP.X, midP.Y, zPos) * CFrame.Angles(0, 0, lineAngle)

                local segmentPhase = segData.arm * 0.5 + (segData.seg / segData.total) * 1.5
                segData.part.Color = getPortalBackgroundColor(elapsed * 1.1 + data.colorSeed + segmentPhase)
            end

            for _, dotData in ipairs(data.movingDots) do
                local t = elapsed * dotData.speed + dotData.seed
                local angle = t * 1.3
                local rx = dotData.minRadiusX + (math.abs(math.sin(t * 0.7)) * (dotData.maxRadiusX - dotData.minRadiusX))
                local ry = dotData.minRadiusY + (math.abs(math.cos(t * 0.9)) * (dotData.maxRadiusY - dotData.minRadiusY))

                local dx = math.cos(angle) * rx * pulseScaleX
                local dy = math.sin(angle * 1.1) * ry * pulseScaleY

                dotData.part.CFrame = data.portal.CFrame * CFrame.new(dx, dy, dotData.zOffset)
            end
        end
    end)

    local function handleTeleport(fromPortal, destinationCFrame, portalData)
        fromPortal.Touched:Connect(function(hit)
            if teleportDebounce then return end
            local char = player.Character
            if not char or not hit:IsDescendantOf(char) then return end
            local hum = char:FindFirstChildOfClass("Humanoid")
            local rootPart = char:FindFirstChild("HumanoidRootPart")
            if not hum or not rootPart then return end

            teleportDebounce = true
            playScreenFlash()

            if portalData and portalData.portal then
                local squishTween = TweenService:Create(portalData.portal, TweenInfo.new(0.12, Enum.EasingStyle.Sine, Enum.EasingDirection.Out), {
                    Size = Vector3.new(portalData.targetSize.X * 1.2, portalData.targetSize.Y * 0.75, portalData.targetSize.Z * 1.4)
                })
                squishTween:Play()
                squishTween.Completed:Connect(function()
                    TweenService:Create(portalData.portal, TweenInfo.new(0.25, Enum.EasingStyle.Elastic, Enum.EasingDirection.Out), {
                        Size = portalData.targetSize
                    }):Play()
                end)
            end

            if targetPlaceId then
                local success, err = pcall(function()
                    TeleportService:Teleport(targetPlaceId, player)
                end)
                if not success then
                    warn("Teleport failed: " .. tostring(err))
                    status.Text = "⚠ Ошибка телепортации: " .. tostring(err)
                    status.TextColor3 = Color3.fromRGB(255, 100, 100)
                    teleportDebounce = false
                end
            else
                local safeExitPosition = destinationCFrame * CFrame.new(0, 0, -4)
                rootPart.CFrame = CFrame.lookAt(safeExitPosition.Position, safeExitPosition.Position + destinationCFrame.LookVector)
                rootPart.AssemblyLinearVelocity = Vector3.zero
                rootPart.AssemblyAngularVelocity = Vector3.zero

                task.wait(0.8)
                teleportDebounce = false
            end
        end)
    end

    if exitData then
        handleTeleport(entranceData.portal, exitData.baseCFrame, entranceData)
        handleTeleport(exitData.portal, entranceData.baseCFrame, exitData)
    else
        handleTeleport(entranceData.portal, entranceData.baseCFrame, entranceData)
    end

    task.delay(portalLifetime, function()
        if currentPortalModel ~= model then return end

        if portalAnimationConnection then
            portalAnimationConnection:Disconnect()
            portalAnimationConnection = nil
        end

        local collapseInfo = TweenInfo.new(0.45, Enum.EasingStyle.Back, Enum.EasingDirection.In)

        for _, data in ipairs(activePortals) do
            local centerCFrame = data.portal.CFrame

            TweenService:Create(data.portal, collapseInfo, {
                Size = Vector3.new(0.01, 0.01, 0.01),
                Transparency = 1
            }):Play()

            if data.light then
                TweenService:Create(data.light, TweenInfo.new(0.3), {Brightness = 0}):Play()
            end

            for _, segData in ipairs(data.spiralLineSegments) do
                TweenService:Create(segData.part, collapseInfo, {
                    CFrame = centerCFrame * CFrame.new(0, 0, segData.side * 0.12),
                    Size = Vector3.new(0.01, 0.01, 0.01),
                    Transparency = 1
                }):Play()
            end

            for _, dotData in ipairs(data.movingDots) do
                TweenService:Create(dotData.part, collapseInfo, {
                    CFrame = centerCFrame * CFrame.new(0, 0, dotData.zOffset),
                    Size = Vector3.new(0.01, 0.01, 0.01),
                    Transparency = 1
                }):Play()
            end
        end

        task.wait(0.5)
        removePortal()
    end)
end

local function createPortalPair(targetPosition, targetPlaceId, portalLifetime, exitCFrameOverride)
    local character = player.Character
    if not character then return end
    local root = character:FindFirstChild("HumanoidRootPart")
    if not root then return end

    portalRequestId = portalRequestId + 1
    local requestId = portalRequestId

    local forward = root.CFrame.LookVector
    -- Входной портал перед вашим игроком
    local entranceCFrame = CFrame.lookAt(root.Position + forward * PORTAL_SPAWN_DISTANCE, root.Position + forward * PORTAL_SPAWN_DISTANCE + forward)

    local startPos = root.Position + forward * 2 + Vector3.new(0, 0.5, 0)
    local equippedTool = character:FindFirstChild("Portal Gun")
    if equippedTool then
        local frontPanel = equippedTool:FindFirstChild("FrontPanel")
        if frontPanel then startPos = frontPanel.Position end
    end

    fireLiquidShot(startPos, entranceCFrame, function()
        if requestId ~= portalRequestId then return end
        removePortal()
        spawnPortalModel(entranceCFrame, targetPosition, targetPlaceId, portalLifetime, 0.18, exitCFrameOverride)
    end)
end

local function createPortalUnderSelf(targetPosition, targetPlaceId, portalLifetime, exitCFrameOverride)
    local character = player.Character
    if not character then return end
    local root = character:FindFirstChild("HumanoidRootPart")
    if not root then return end

    portalRequestId = portalRequestId + 1

    local flatCFrame = CFrame.new(root.Position - Vector3.new(0, 3, 0)) * CFrame.Angles(math.rad(90), 0, 0)

    removePortal()
    spawnPortalModel(flatCFrame, targetPosition, targetPlaceId, portalLifetime, 0, exitCFrameOverride)
end

