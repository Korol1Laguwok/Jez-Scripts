local function updatePlayerList()
    for _, child in ipairs(playersScroll:GetChildren()) do
        if child:IsA("TextButton") then
            child:Destroy()
        end
    end

    local count = 0
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= player then
            count = count + 1
            local item = Instance.new("TextButton")
            item.Name = p.Name
            item.Size = UDim2.new(1, -8, 0, 42)
            item.BackgroundColor3 = (selectedPlayer == p) and Color3.fromRGB(45, 55, 70) or Color3.fromRGB(28, 33, 42)
            item.AutoButtonColor = false
            item.Text = ""
            item.Parent = playersScroll

            local itemCorner = Instance.new("UICorner")
            itemCorner.CornerRadius = UDim.new(0, 8)
            itemCorner.Parent = item

            local itemStroke = Instance.new("UIStroke")
            itemStroke.Color = (selectedPlayer == p) and WHITE_ACCENT or Color3.fromRGB(50, 60, 75)
            itemStroke.Thickness = (selectedPlayer == p) and 1.5 or 1
            itemStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
            itemStroke.Parent = item

            local avatar = Instance.new("ImageLabel")
            avatar.Size = UDim2.fromOffset(34, 34)
            avatar.Position = UDim2.fromOffset(4, 4)
            avatar.BackgroundTransparency = 1
            avatar.Image = "rbxthumb://type=AvatarHeadShot&id=" .. p.UserId .. "&w=150&h=150"
            avatar.Parent = item

            local avatarCorner = Instance.new("UICorner")
            avatarCorner.CornerRadius = UDim.new(0, 17)
            avatarCorner.Parent = avatar

            local nameLabel = Instance.new("TextLabel")
            nameLabel.Size = UDim2.new(1, -50, 1, 0)
            nameLabel.Position = UDim2.fromOffset(45, 0)
            nameLabel.BackgroundTransparency = 1
            nameLabel.Text = p.DisplayName .. " (@" .. p.Name .. ")"
            nameLabel.TextColor3 = WHITE_ACCENT
            nameLabel.Font = Enum.Font.GothamMedium
            nameLabel.TextSize = 13
            nameLabel.TextXAlignment = Enum.TextXAlignment.Left
            nameLabel.TextTruncate = Enum.TextTruncate.AtEnd
            nameLabel.Parent = item

            item.MouseButton1Click:Connect(function()
                selectedPlayer = p
                updatePlayerList()
            end)
        end
    end

    playersScroll.CanvasSize = UDim2.fromOffset(0, count * 46)
end

